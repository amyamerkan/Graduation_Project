  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_5465eb323c1c76b7">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">vật cổ truyen Việt Nam</rdfs:label>
    <vn:name>vật cổ truyen Việt Nam</vn:name>
    <vn:description xml:lang="vi">Hình ảnh chụp một gia đình bốn người (ông bà và hai cháu) đang chuẩn bị làm bánh chưng trong không gian trước nhà truyền thống của người Việt Nam vào dịp Tết Nguyên Đán. Hình ảnh phản ánh nét văn hóa chung của người Việt Nam, tuy nhiên, chi tiết về kiến trúc nhà cửa có thể có sự khác biệt nhỏ giữa các vùng miền. Việc làm bánh chưng đã có từ lâu đời, gắn liền với truyền thuyết An Dương Vương và bánh chưng, bánh giầy. Hình ảnh phản ánh một truyền thống lâu đời của người Việt. Truyền thống làm bánh chưng vẫn được duy trì và phát triển cho đến ngày nay, đặc biệt là trong dịp Tết Nguyên Đán. Hình ảnh này khơi gợi ký ức về ngày Tết và giá trị gia đình. Làm bánh chưng là một hoạt động văn hóa quan trọng của người Việt trong dịp Tết, thể hiện tinh thần đoàn kết, sum họp gia đình. Hình ảnh này phản ánh rõ nét truyền thống văn hoá Tết Nguyên Đán của người Việt, nhấn mạnh giá trị gia đình và sự chuẩn bị chu đáo cho ngày Tết. Hình ảnh mang ý nghĩa sâu sắc về văn hoá, tình cảm gia đình và sự gìn giữ bản sắc dân tộc. Việc làm bánh chưng là một nghi lễ quan trọng, thể hiện sự kế thừa và phát huy truyền thống văn hoá của người Việt. Sự khác biệt nhỏ này phản ánh sự đa dạng văn hóa của Việt Nam nhưng vẫn giữ được tinh thần chung của truyền thống làm bánh chưng. vật cổ truyen Việt Nam</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
    <vn:sourceRecordId>00caa5fd3d81a4188c40310397bc8e62dbed42fb7a181eca1dac539db72ada3c</vn:sourceRecordId>
    <vn:sourceRecordId>00e81c1a74a715779c41deb5d69ed35affb637cfd343fd67153d88e615d2c4de</vn:sourceRecordId>
    <vn:sourceRecordId>027bd8489784721fafb2bad02cd0e88a69a1ed043bcb6d7daccc586e1199c6ed</vn:sourceRecordId>
    <vn:sourceRecordId>0f07ea67b6c112d8f033b821faf1bb6e74e05d272dec154b6bd5eacae5b2a969</vn:sourceRecordId>
