  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_060f57a71a22754b">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">đan bầu Việt Nam</rdfs:label>
    <vn:name>đan bầu Việt Nam</vn:name>
    <vn:description xml:lang="vi">Hình ảnh chụp toàn cảnh một cây đàn bầu Việt Nam, được đặt trên nền đen. Đàn được đặt nằm ngang, cho thấy rõ chi tiết cấu tạo và họa tiết trang trí. Được sử dụng rộng rãi trên khắp cả nước, nhưng mỗi vùng miền có thể có những biến thể nhỏ về kiểu dáng và chất liệu. Nguồn gốc đàn bầu còn nhiều tranh luận, tuy nhiên, có bằng chứng cho thấy nó đã tồn tại từ thế kỷ 18 hoặc sớm hơn. Nó từng được sử dụng trong các cung đình, nay phổ biến trong các dàn nhạc dân tộc và cả biểu diễn độc tấu. Vẫn được sử dụng phổ biến trong âm nhạc truyền thống, nhạc nhẹ và cả nhạc phim, góp phần quảng bá văn hóa Việt Nam ra thế giới. Đàn bầu được xem là biểu tượng của âm nhạc Việt Nam, đại diện cho hồn cốt của dân tộc, thường được sử dụng trong các dịp lễ hội, tang lễ và các sự kiện văn hóa quan trọng. Sự kết hợp giữa màu sắc, chất liệu và họa tiết trang trí trên đàn bầu thể hiện sự am hiểu về thẩm mỹ và tinh thần nghệ thuật của người Việt Nam. Đàn bầu là một phần không thể thiếu trong đời sống văn hóa tinh thần của người Việt, được sử dụng trong các lễ hội, nghi lễ truyền thống, góp phần bảo tồn và phát huy các giá trị văn hóa truyền thống. Đàn bầu đóng góp quan trọng vào sự đa dạng và phong phú của âm nhạc Việt Nam, góp phần định hình bản sắc văn hóa âm nhạc của dân tộc. Sự khác biệt này tạo nên nét độc đáo riêng biệt của đàn bầu trong hệ thống các nhạc cụ truyền thống của Việt Nam, làm phong phú thêm bức tranh âm nhạc dân tộc.</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
    <vn:sourceRecordId>0503edf1768986c596efdbb2bb338e8645bc3e9532039f2227643140eb37db94</vn:sourceRecordId>
