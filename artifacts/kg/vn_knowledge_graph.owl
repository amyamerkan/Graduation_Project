  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_f8a96477689de00b">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">múa rồng</rdfs:label>
    <vn:name>múa rồng</vn:name>
    <vn:description xml:lang="vi">Hình ảnh chụp cận cảnh hai đầu rồng được sử dụng trong trò chơi dân gian múa rồng của Việt Nam. Chúng được đặt trên một bề mặt đá, phía sau là hàng rào lưới kim loại và một số tán cây. Múa rồng phổ biến khắp cả nước nhưng có thể có những biến thể nhỏ về hình thức, màu sắc và trang phục theo từng vùng miền. Nguồn gốc của múa rồng tại Việt Nam có liên hệ mật thiết với văn hoá Trung Hoa nhưng đã được Việt Nam hoá qua thời gian, thể hiện trong kiểu dáng, màu sắc và các động tác múa. Múa rồng vẫn được duy trì và phát triển, xuất hiện trong các lễ hội, sự kiện văn hoá, du lịch, góp phần quảng bá hình ảnh văn hoá Việt Nam. Múa rồng là một phần không thể thiếu trong văn hoá Việt Nam, biểu tượng cho sự may mắn, thịnh vượng và sức mạnh. Hình ảnh phản ánh sự gìn giữ và phát triển nghệ thuật truyền thống của người Việt Nam. Múa rồng không chỉ là một trò chơi giải trí mà còn là một phần không thể thiếu trong các lễ hội truyền thống, thể hiện bản sắc văn hoá dân tộc. Múa rồng là một biểu hiện sinh động của tinh thần cộng đồng và sự gắn kết giữa con người với nhau, thể hiện sự tôn trọng và gìn giữ các giá trị truyền thống. Sự khác biệt này phản ánh sự tiếp biến văn hóa và sự sáng tạo của người Việt Nam trong việc thích nghi và phát triển các hình thức nghệ thuật truyền thống.</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
