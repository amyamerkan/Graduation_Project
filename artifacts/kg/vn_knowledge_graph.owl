  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_78b758e16604b31e">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">banh đậu xanh</rdfs:label>
    <vn:name>banh đậu xanh</vn:name>
    <vn:description xml:lang="vi">Hình ảnh quảng cáo sản phẩm bánh đậu xanh Hòa An, bao gồm hình ảnh hộp bánh 1kg, các gói bánh nhỏ hơn và thông tin sản phẩm. Bánh đậu xanh phổ biến khắp cả nước, nhưng mỗi vùng miền có thể có những biến thể về vị ngọt, độ dẻo, hình dáng. Bánh đậu xanh có lịch sử lâu đời ở Việt Nam, xuất hiện từ nhiều thế kỷ trước, gắn liền với các dịp lễ Tết và làm quà biếu. Bánh đậu xanh được sản xuất và tiêu thụ rộng rãi, đóng góp vào nền kinh tế và văn hóa ẩm thực Việt Nam hiện đại, được bán rộng rãi ở các cửa hàng, siêu thị và online. Bánh đậu xanh là món ăn quen thuộc trong văn hóa ẩm thực Việt Nam, đặc biệt là trong các dịp lễ tết. Nó tượng trưng cho sự may mắn, ngọt ngào và thịnh vượng. Việc quảng cáo sản phẩm truyền thống như bánh đậu xanh phản ánh sự phát triển của thị trường nội địa và xu hướng hiện đại hóa trong việc kinh doanh và tiếp thị sản phẩm văn hóa truyền thống Việt. Hình ảnh phản ánh xu hướng hiện đại hóa trong việc quảng bá và bảo tồn các giá trị văn hóa ẩm thực truyền thống của Việt Nam. Bánh đậu xanh là một phần không thể thiếu trong văn hóa ẩm thực và truyền thống của Việt Nam, thể hiện sự tinh tế và khéo léo của người chế biến. Sự đa dạng của bánh đậu xanh theo vùng miền phản ánh sự phong phú và đa dạng của văn hóa ẩm thực Việt Nam.</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
