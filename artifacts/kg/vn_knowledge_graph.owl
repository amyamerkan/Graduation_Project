  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_c7573c3f5fe20a33">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">thổ cẩm dệt</rdfs:label>
    <vn:name>thổ cẩm dệt</vn:name>
    <vn:description xml:lang="vi">Hình ảnh chụp một nhóm phụ nữ dân tộc thiểu số Việt Nam đang dệt thổ cẩm. Họ ngồi sát nhau, tập trung vào công việc, thể hiện sự khéo léo và tinh thần cộng đồng. Văn hóa dệt thổ cẩm phổ biến ở nhiều vùng miền núi phía Bắc Việt Nam như Tây Bắc, Cao Bằng, Hà Giang,... mỗi vùng có họa tiết và màu sắc khác nhau. Nghề dệt thổ cẩm có lịch sử lâu đời, gắn liền với đời sống văn hóa tinh thần của các dân tộc thiểu số, truyền từ đời này sang đời khác. Thổ cẩm hiện nay không chỉ giữ vai trò trong đời sống hàng ngày mà còn là sản phẩm du lịch, đóng góp vào phát triển kinh tế địa phương và bảo tồn văn hóa. Hình ảnh phản ánh truyền thống dệt thổ cẩm lâu đời của các dân tộc Việt Nam, một nét văn hóa độc đáo và quý giá. Thổ cẩm không chỉ là sản phẩm thủ công mà còn là biểu tượng văn hóa, chứa đựng giá trị lịch sử, tinh thần của các cộng đồng dân tộc thiểu số. Thổ cẩm được xem như một di sản văn hóa phi vật thể quý báu, phản ánh sự sáng tạo và trí tuệ của người dân tộc. Bảo tồn nghề dệt thổ cẩm là bảo tồn một phần quan trọng của di sản văn hóa phi vật thể quốc gia, đóng góp vào sự đa dạng văn hóa của Việt Nam. Sự đa dạng này làm nên nét độc đáo của văn hóa thổ cẩm Việt Nam, là nguồn tài nguyên vô giá cần được bảo tồn và phát huy.</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
