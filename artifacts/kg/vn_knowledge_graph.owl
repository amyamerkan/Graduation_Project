  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/sourcedocument_0022c8b7d9a7828c">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#SourceDocument"/>
    <rdfs:label xml:lang="vi">{'name': 'Chiếc xe chở vũ khí và câu chuyện về biệt động Ba Mủ', 'category': 'Hiện vật tiêu biểu'}</rdfs:label>
    <vn:name>{'name': 'Chiếc xe chở vũ khí và câu chuyện về biệt động Ba Mủ', 'category': 'Hiện vật tiêu biểu'}</vn:name>
    <vn:sourceName>Vimuseum_QA</vn:sourceName>
    <vn:sourceRecordId>9712e29e65001761504e77e4985515c9b91e6f498222c6b7fda5a70f42a5e172</vn:sourceRecordId>
