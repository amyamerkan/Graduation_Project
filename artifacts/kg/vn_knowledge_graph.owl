  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_697dfc2b0407a1d9">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">gốm su Bat Trang</rdfs:label>
    <vn:name>gốm su Bat Trang</vn:name>
    <vn:description xml:lang="vi">Hình ảnh chụp cận cảnh một chiếc bình gốm sứ Bát Tràng có hình dáng cầu, trang trí họa tiết chim công và hoa văn cổ điển. Bình được đặt trên một đế gỗ nhỏ, trên nền đen tối tạo độ tương phản. Sản phẩm tiêu biểu của làng nghề gốm sứ Bát Tràng (Hà Nội), nổi tiếng với chất lượng cao và kỹ thuật tinh xảo. Nghề gốm Bát Tràng có lịch sử hàng trăm năm, truyền từ đời này sang đời khác. Họa tiết chim công thể hiện sự sang trọng, trường thọ trong văn hóa Việt Nam, bắt nguồn từ truyền thống Á Đông. Gốm sứ Bát Tràng vẫn được ưa chuộng rộng rãi, không chỉ trong nước mà cả quốc tế, là sản phẩm lưu niệm, trang trí cao cấp. Bình gốm sứ là một sản phẩm thủ công mỹ nghệ truyền thống của Việt Nam, thể hiện sự khéo léo và tinh thần sáng tạo của người nghệ nhân. Hình ảnh này phản ánh sự phát triển và kế thừa của làng nghề truyền thống, sự kết hợp giữa yếu tố cổ điển và hiện đại trong nghệ thuật trang trí gốm sứ Việt Nam. Sản phẩm này góp phần quảng bá hình ảnh văn hóa Việt Nam ra thế giới, thể hiện sự tinh tế và tài hoa của người nghệ nhân Việt. Gốm sứ Bát Tràng là minh chứng sống động cho sự trường tồn và phát triển của văn hóa Việt, là niềm tự hào của người dân Việt Nam. Sự khác biệt này tạo nên nét đặc trưng riêng của gốm sứ Bát Tràng, góp phần làm phong phú thêm bức tranh văn hóa đa dạng của Việt Nam.</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
