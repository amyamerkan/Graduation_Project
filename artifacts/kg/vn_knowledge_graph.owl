  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_c4322ea5a91a9082">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">le hoi Sene Dolta</rdfs:label>
    <vn:name>le hoi Sene Dolta</vn:name>
    <vn:description xml:lang="vi">Hình ảnh chụp một lễ hội Sen Dolta của người Khmer tại Việt Nam. Bức ảnh cho thấy một nhóm người đông đảo đang quỳ trước một bàn thờ lớn được trang trí với rất nhiều nến, hoa và các vật phẩm cúng tế khác. Ánh sáng ấm áp của nến tạo nên không khí trang nghiêm và linh thiêng. Lễ hội Sen Dolta chủ yếu được tổ chức ở các tỉnh miền Tây Nam Bộ, nơi cư trú của cộng đồng người Khmer tại Việt Nam. Lễ hội Sen Dolta có nguồn gốc từ tín ngưỡng Phật giáo Nam tông của người Khmer, liên quan đến truyền thuyết về sự ra đời của Đức Phật. Lễ hội vẫn được duy trì và phát triển, thể hiện sự gắn kết cộng đồng và bảo tồn bản sắc văn hóa Khmer tại Việt Nam. Nó cũng thu hút sự chú ý của du khách trong và ngoài nước. Lễ hội Sen Dolta thể hiện sự tôn kính Phật giáo Nam tông và các giá trị truyền thống của người Khmer. Việc duy trì lễ hội này góp phần bảo tồn và phát triển văn hóa dân tộc. Cảnh tượng thể hiện sự sùng bái tôn giáo sâu sắc và sự gắn kết cộng đồng trong các lễ hội truyền thống của người Khmer. Lễ hội này phản ánh sâu sắc tín ngưỡng Phật giáo Nam tông và quan niệm về nhân quả, sự sống và cái chết trong văn hoá Khmer. Lễ hội góp phần khẳng định vị trí và vai trò của cộng đồng người Khmer trong xã hội Việt Nam, đồng thời thể hiện sức sống mãnh liệt của văn hóa Khmer trong thời đại hiện nay. Sự khác biệt này thể hiện sự đa dạng văn hóa của Việt Nam, tôn trọng và bảo tồn bản sắc của các cộng đồng dân tộc.</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
