  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_645ac16ab7dec2eb">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">cot co Ha Noi</rdfs:label>
    <vn:name>cot co Ha Noi</vn:name>
    <vn:description xml:lang="vi">Hình ảnh là một minh họa cách điệu của Cột cờ Hà Nội, nhìn từ góc độ thấp, hướng lên phía trên. Cột cờ được thể hiện với các màu sắc đơn giản, tương phản, tạo cảm giác hiện đại nhưng vẫn giữ được những nét kiến trúc đặc trưng. Cột cờ Hà Nội là biểu tượng của Hà Nội và cả Việt Nam. Nó nằm tại Quảng trường Ba Đình, nơi Chủ tịch Hồ Chí Minh đọc bản Tuyên ngôn độc lập năm 1945. Cột cờ Hà Nội được xây dựng nhiều lần qua các triều đại. Cột cờ hiện tại được xây dựng sau năm 1954, đánh dấu sự thống nhất đất nước. Nó là nơi diễn ra các sự kiện lịch sử trọng đại của quốc gia. Cột cờ vẫn là một điểm đến du lịch quan trọng, là biểu tượng của tinh thần dân tộc, lòng yêu nước và sự thống nhất đất nước. Nó thường xuyên xuất hiện trong các dịp lễ hội, kỷ niệm quốc gia. Cột cờ là biểu tượng của chủ quyền và độc lập dân tộc, thể hiện sức mạnh đoàn kết và tinh thần tự cường của người Việt Nam. Hình ảnh nhấn mạnh ý nghĩa biểu tượng của cột cờ đối với dân tộc Việt Nam, khẳng định chủ quyền và tinh thần dân tộc. Cột cờ là điểm hội tụ của lòng yêu nước, tinh thần dân tộc, và niềm tin vào tương lai tươi sáng của đất nước. Cột cờ không chỉ là một di tích lịch sử, mà còn là nơi thể hiện sự tôn nghiêm, lòng tự hào dân tộc và khát vọng hòa bình, thống nhất đất nước. Sự khác biệt này làm nổi bật vai trò của Hà Nội như là trung tâm chính trị, văn hóa của đất nước và sự kiện lịch sử trọng đại đã diễn ra tại đây.</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
    <vn:sourceRecordId>024158f2dee0088d7885614373892721683bb5c67f024f12103a704f4418d652</vn:sourceRecordId>
    <vn:sourceRecordId>04cc976bb5b0e98d48920a8d88c5468ef20cd95b7c45abb74f50c3294e296e7e</vn:sourceRecordId>
