  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_ba9fc08aa185e6d3">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">sông Mekong</rdfs:label>
    <vn:name>sông Mekong</vn:name>
    <vn:description xml:lang="vi">Hình ảnh chụp cảnh quan sông Mekong, tập trung vào một nhóm ghe thuyền đậu sát bờ. Những chiếc ghe được sơn nhiều màu sắc rực rỡ, chất đầy hàng hóa và dụng cụ đánh cá. Nền là dòng sông rộng lớn và một làng mạc ở phía xa. Đặc trưng của vùng Đồng bằng sông Cửu Long, miền Tây Nam Bộ, Việt Nam. Loại hình ghe thuyền này khá phổ biến ở các tỉnh An Giang, Kiên Giang, Cần Thơ... Loại hình ghe thuyền này đã tồn tại từ lâu đời, gắn liền với lịch sử khai phá và phát triển vùng sông nước. Chúng là phương tiện giao thông, vận chuyển, buôn bán chính của người dân. Dù có sự phát triển của giao thông đường bộ, ghe thuyền vẫn đóng vai trò quan trọng trong đời sống kinh tế và văn hóa của người dân vùng sông nước. Chúng vẫn được sử dụng để vận chuyển hàng hóa, đánh bắt cá và là một phần không thể thiếu của cảnh quan. Hình ảnh này thể hiện sự gắn bó mật thiết giữa người dân và con sông – nguồn sống chính của họ. Nó thể hiện một nét văn hoá đặc trưng của vùng sông nước Việt Nam. Đây là minh chứng rõ nét cho lối sống cộng đồng, dựa vào thiên nhiên, tận dụng tối đa nguồn lợi từ sông nước của người dân vùng này. Nó thể hiện sự thích nghi tài tình với điều kiện sống đặc thù. Sự đa dạng về hình dáng và màu sắc của ghe thuyền thể hiện sự phong phú về văn hoá vật chất và tinh thần của vùng sông nước. Nó góp phần tạo nên một bức tranh văn hoá đặc trưng, khác biệt so với các vùng miền khác của Việt Nam. Việc nghiên cứu những hình ảnh này sẽ giúp bảo tồn và phát huy những giá trị văn hoá truyền thống quý báu của dân tộc, góp phần xây dựng và phát triển nền văn hoá Việt Nam ngày càng giàu đẹp. Sự khác biệt này phản ánh sự đa dạng địa hình và tập quán của các vùng miền Việt Nam. Mỗi loại phương tiện vận chuyển đều thích ứng với điều kiện tự nhiên và nhu cầu của từng vùng.</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
