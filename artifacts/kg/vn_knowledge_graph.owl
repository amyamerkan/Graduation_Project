  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_2212a5b552a6903f">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">le hoi Óc Om Bóc</rdfs:label>
    <vn:name>le hoi Óc Om Bóc</vn:name>
    <vn:description xml:lang="vi">Hình ảnh chụp một cuộc đua thuyền truyền thống trong lễ hội Óc Om Bóc. Hình ảnh tập trung vào một chiếc thuyền đang đua, với các tay chèo mặc áo cam đồng phục và đội mũ lưỡi trai cùng màu. Phía sau là nhiều thuyền khác đang tham gia cuộc đua và một đám đông khán giả đứng xem. Lễ hội Óc Om Bóc là lễ hội truyền thống của người Khmer ở các tỉnh miền Tây Nam Bộ, Việt Nam. Nó đặc biệt phổ biến ở các tỉnh như Sóc Trăng, Trà Vinh, Bạc Liêu. Lễ hội có nguồn gốc từ lâu đời, liên quan đến tín ngưỡng và đời sống nông nghiệp của người Khmer. Nó thể hiện sự gắn bó mật thiết của cộng đồng với sông nước và mùa màng. Ngày nay, lễ hội vẫn được duy trì và phát triển, trở thành một điểm thu hút khách du lịch trong nước và quốc tế. Nó góp phần bảo tồn và phát huy giá trị văn hóa truyền thống của người Khmer ở Việt Nam. Lễ hội Óc Om Bóc thể hiện tinh thần đoàn kết, sức mạnh cộng đồng và lòng dũng cảm của người dân. Nó là một phần quan trọng trong bản sắc văn hóa Khmer Nam Bộ. Sự tập trung, nỗ lực của các tay chèo thể hiện tinh thần thi đấu cao, khát khao chiến thắng. Hình ảnh phản ánh sức mạnh, sự bền bỉ và tinh thần đồng đội trong văn hóa người Khmer. Lễ hội Óc Om Bóc phản ánh sự giao thoa hài hòa giữa đời sống vật chất và tinh thần của người dân, là biểu tượng của truyền thống văn hóa lâu đời. Lễ hội Óc Om Bóc là biểu tượng của sự trường tồn và phát triển của văn hóa Khmer trong bối cảnh hội nhập, góp phần bảo tồn di sản văn hóa phi vật thể của Việt Nam. Sự khác biệt này khẳng định tính đa dạng và phong phú của văn hóa Việt Nam, thể hiện sự giao thoa và đồng hành của các nền văn hóa khác nhau trên cùng một lãnh thổ.</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
