  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_fbfa4c5925211330">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">nha hat Lớn Ha Noi</rdfs:label>
    <vn:name>nha hat Lớn Ha Noi</vn:name>
    <vn:description xml:lang="vi">Hình ảnh chụp toàn cảnh Nhà hát Lớn Hà Nội từ phía trên, thể hiện kiến trúc bên trong với khán phòng hình móng ngựa, các dãy ghế ngồi được sắp xếp theo tầng, sân khấu và rèm nhung đỏ. Biểu tượng văn hóa của Hà Nội và Việt Nam, nằm ở trung tâm thành phố. Được xây dựng vào cuối thế kỷ 19 (1911), mang phong cách kiến trúc Pháp, là di sản kiến trúc có giá trị lịch sử và nghệ thuật. Là địa điểm tổ chức các sự kiện văn hóa nghệ thuật quan trọng, thu hút khách du lịch trong và ngoài nước, biểu tượng cho sự phát triển văn hóa của Việt Nam. Nhà hát là biểu tượng văn hoá của Hà Nội và Việt Nam, là nơi diễn ra nhiều sự kiện văn hoá nghệ thuật quan trọng. Nó phản ánh sự phát triển của nghệ thuật biểu diễn tại Việt Nam và sự ảnh hưởng của văn hoá Pháp. Kiến trúc này phản ánh sự ảnh hưởng của kiến trúc Pháp cổ điển đến Việt Nam, đồng thời cũng thể hiện sự đầu tư vào nghệ thuật biểu diễn và đời sống văn hóa của người Việt thời bấy giờ. Nhà hát là minh chứng cho sự phát triển văn hoá, sự giao thoa và hội nhập văn hoá quốc tế của Việt Nam. Nó đóng vai trò quan trọng trong việc bảo tồn và phát huy các giá trị nghệ thuật truyền thống và hiện đại. Nhà hát đóng vai trò quan trọng trong việc bảo tồn và phát huy giá trị nghệ thuật truyền thống, đồng thời là cầu nối giao lưu văn hoá quốc tế, góp phần xây dựng hình ảnh đất nước. Sự khác biệt này phản ánh sự phát triển không đồng đều về kinh tế, văn hoá giữa các vùng miền, cũng như sự tập trung các hoạt động văn hoá lớn ở trung tâm.</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
