  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_f28de32641caf230">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">wood carving</rdfs:label>
    <vn:name>wood carving</vn:name>
    <vn:description xml:lang="vi">Hình ảnh cận cảnh bàn tay một người thợ đang tỉ mẩn chạm khắc gỗ, xung quanh là các dụng cụ điêu khắc và mạt gỗ. Nghề điêu khắc gỗ phổ biến khắp Việt Nam, nhưng mỗi vùng miền có những đặc trưng riêng về kiểu dáng, hoa văn và chất liệu gỗ. Nghề điêu khắc gỗ có lịch sử lâu đời ở Việt Nam, gắn liền với kiến trúc, tôn giáo và đời sống văn hóa. Nghề điêu khắc gỗ vẫn được gìn giữ và phát triển, đóng góp vào ngành du lịch và xuất khẩu hàng thủ công mỹ nghệ. Nghề chạm khắc gỗ là một phần quan trọng của di sản văn hóa Việt Nam, thể hiện sự sáng tạo và tinh thần cần cù của người dân. Hình ảnh này thể hiện sự kế thừa và phát triển của nghề thủ công truyền thống, góp phần bảo tồn và quảng bá văn hóa Việt Nam. Hình ảnh này nhắc nhở chúng ta về giá trị của nghề thủ công truyền thống và tầm quan trọng của việc bảo tồn di sản văn hóa phi vật thể. Việc bảo tồn và phát triển nghề điêu khắc gỗ là một trong những cách để bảo tồn và phát huy bản sắc văn hóa dân tộc. Sự khác biệt này phản ánh sự đa dạng văn hóa và sự sáng tạo độc đáo của người Việt trong nghệ thuật điêu khắc gỗ.</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
