  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_ef8fac1652abc152">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">đen Bạch Ma</rdfs:label>
    <vn:name>đen Bạch Ma</vn:name>
    <vn:description xml:lang="vi">Hình ảnh chụp một nhóm người mặc áo dài vàng tham gia lễ hội truyền thống tại Đền Bạch Mã, Hà Nội. Bối cảnh là một ngôi đền truyền thống với kiến trúc mái ngói đỏ, cửa chính được trang trí với đèn lồng đỏ và một băng rôn lớn ghi thông tin về lễ hội. Đền Bạch Mã nằm ở Hà Nội, hình ảnh phản ánh văn hóa truyền thống của khu vực miền Bắc Việt Nam. Đền Bạch Mã có lịch sử lâu đời, lễ hội thường niên thể hiện sự duy trì và phát triển văn hóa tín ngưỡng của người dân. Hình ảnh cho thấy sự duy trì và phát triển các giá trị văn hóa truyền thống trong đời sống hiện đại, đồng thời thu hút khách du lịch. Hình ảnh thể hiện sự kế thừa và phát huy các giá trị văn hóa truyền thống của Việt Nam, trong đó có tín ngưỡng thờ tự và các lễ hội dân gian. Áo dài là biểu tượng văn hóa đặc trưng của Việt Nam, thể hiện sự nữ tính, duyên dáng và tinh tế của người phụ nữ Việt. Các lễ hội truyền thống đóng vai trò quan trọng trong đời sống văn hóa tinh thần của người Việt, giúp bảo tồn và phát triển bản sắc văn hóa dân tộc. Hình ảnh đóng góp vào việc hiểu biết sâu sắc hơn về sự đa dạng và phong phú của văn hóa Việt Nam, giúp thúc đẩy công tác bảo tồn và phát huy các giá trị văn hóa truyền thống. Sự đa dạng của các lễ hội phản ánh sự phong phú và đa dạng của văn hóa Việt Nam.</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
