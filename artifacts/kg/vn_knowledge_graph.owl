    <rdfs:label xml:lang="vi">Chiếc áo trấn thủ Bác Hồ tặng</rdfs:label>
    <vn:name>Chiếc áo trấn thủ Bác Hồ tặng</vn:name>
    <vn:description xml:lang="vi">Chiếc áo trấn thủ được Bác Hồ tặng cụ Nguyễn Đức Lô do cụ đã lập được thành tích xuất sắc trong Chiến dịch Biên giới năm 1950.</vn:description>
