    <rdfs:label xml:lang="vi">Giấy chứng nhận danh hiệu “dũng sĩ diệt máy bay Mỹ”</rdfs:label>
    <vn:name>Giấy chứng nhận danh hiệu “dũng sĩ diệt máy bay Mỹ”</vn:name>
