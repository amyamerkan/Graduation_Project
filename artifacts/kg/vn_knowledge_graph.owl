  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_01ded263ccc0a64b">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">chùa Trấn Quốc</rdfs:label>
    <vn:name>chùa Trấn Quốc</vn:name>
    <vn:description xml:lang="vi">Hình ảnh chụp một góc sân chùa Trấn Quốc, Hà Nội. Trung tâm là một kiến trúc nhỏ màu vàng, có mái cong truyền thống, được trang trí bằng chữ Hán. Phía sau là một dãy nhà màu vàng và một công trình kiến trúc lớn hơn, cũng mang phong cách truyền thống Việt Nam. Bối cảnh bao gồm cây xanh, sân lát gạch đỏ và một tiểu cảnh non bộ. Đặc trưng của kiến trúc Phật giáo vùng đồng bằng Bắc Bộ, thể hiện ở mái cong, màu sắc và vật liệu sử dụng. Chùa Trấn Quốc có lịch sử lâu đời, trải qua nhiều lần trùng tu, kiến trúc hiện tại phản ánh sự pha trộn giữa các giai đoạn lịch sử khác nhau. Chùa Trấn Quốc vẫn là một địa điểm tâm linh quan trọng, thu hút nhiều du khách trong và ngoài nước, đóng góp vào du lịch văn hóa và bảo tồn di sản. Hình ảnh thể hiện một phần di sản kiến trúc Phật giáo Việt Nam, phản ánh sự kết hợp giữa kiến trúc truyền thống và tín ngưỡng Phật giáo. Phong cách kiến trúc này phản ánh sự giao thoa văn hóa giữa Việt Nam và Trung Quốc, đặc trưng của kiến trúc Phật giáo Việt Nam. Cây tùng là một biểu tượng văn hóa lâu đời ở Đông Á, liên quan đến sự trường thọ, khí phách và sự bền vững của đạo Phật. Việc sử dụng bonsai thể hiện sự kết hợp giữa yếu tố tự nhiên và văn hóa. Chùa Trấn Quốc phản ánh sự giao thoa văn hóa, sự phát triển của Phật giáo và tầm quan trọng của tín ngưỡng trong đời sống người Việt. Nó là biểu tượng của sự bền vững và liên kết giữa quá khứ, hiện tại và tương lai. Sự đa dạng trong kiến trúc chùa chiền phản ánh sự phong phú và đa dạng của văn hóa Việt Nam. Mỗi vùng miền đều có những đặc điểm riêng biệt thể hiện trong kiến trúc Phật giáo, nhưng vẫn giữ được những nét tương đồng chung.</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
