  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_57bf5a570f6e8097">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">thả vòng tre</rdfs:label>
    <vn:name>thả vòng tre</vn:name>
    <vn:description xml:lang="vi">Hình ảnh chụp nội thất một căn phòng hiện đại, với điểm nhấn là hệ thống đèn chùm hình vòng tròn xếp chồng lên nhau, được làm từ kim loại và có ánh sáng LED. Không có ý nghĩa vùng miền cụ thể. Thiết kế hiện đại, không có liên hệ trực tiếp với lịch sử văn hóa. Thể hiện xu hướng thiết kế nội thất hiện đại, chú trọng ánh sáng và sự tối giản. Không có ý nghĩa văn hóa truyền thống Việt Nam. Sự khác biệt thể hiện sự chuyển đổi từ văn hóa truyền thống sang văn hóa hiện đại của Việt Nam.</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
