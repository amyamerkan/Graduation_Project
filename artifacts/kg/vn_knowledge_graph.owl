  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_0cd761d62b1146e6">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">đan K'ni</rdfs:label>
    <vn:name>đan K'ni</vn:name>
    <vn:description xml:lang="vi">Hình ảnh chụp một nhạc cụ truyền thống của người dân tộc K'Ho ở Tây Nguyên, Việt Nam, được gọi là đàn K'ni. Hình ảnh bao gồm toàn bộ cây đàn được đặt trên một mặt phẳng, cùng với một hình ảnh phóng đại chi tiết phần cần đàn. Đặc trưng của văn hóa người K'Ho ở Tây Nguyên, Việt Nam. Lịch sử lâu đời, gắn liền với đời sống tinh thần của người K'Ho, được truyền lại qua nhiều thế hệ. Vẫn được sử dụng trong các lễ hội, nghi lễ truyền thống và đang được bảo tồn, quảng bá để gìn giữ bản sắc văn hóa. Đàn K'ni đóng vai trò quan trọng trong đời sống văn hóa của người K'Ho, được sử dụng trong các lễ hội, nghi lễ và sinh hoạt cộng đồng. Sự chú trọng đến chi tiết trong hình ảnh phản ánh sự tôn trọng đối với nhạc cụ truyền thống và văn hóa của người K'Ho. Đàn K'ni là một di sản văn hóa quý giá, phản ánh sự phong phú và đa dạng của nền văn hóa Việt Nam. Sự tồn tại của đàn K'ni phản ánh sự bền bỉ và giá trị của văn hóa phi vật thể Việt Nam, cần được bảo tồn và phát triển. Sự khác biệt này cho thấy sự đa dạng và độc đáo của văn hoá âm nhạc Việt Nam, phản ánh môi trường sống và tập quán của từng dân tộc.</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
