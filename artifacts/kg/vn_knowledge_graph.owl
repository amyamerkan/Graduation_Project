  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_672a0ee73f58c791">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">ban tho gia tiên</rdfs:label>
    <vn:name>ban tho gia tiên</vn:name>
    <vn:description xml:lang="vi">Hình ảnh liên quan đến ban tho gia tiên trong văn hóa Việt Nam ban tho gia tiên có ý nghĩa quan trọng trong văn hóa Việt Nam Có truyền thống lâu đời trong văn hóa dân tộc Vẫn giữ vai trò quan trọng trong đời sống hiện đại ban tho gia tiên không chỉ có giá trị thực tiễn mà còn mang ý nghĩa tâm linh, thể hiện bản sắc văn hóa dân tộc Việt Nam.</vn:description>
