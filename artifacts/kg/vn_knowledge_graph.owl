  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_79d1d3511cb7cfd9">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">gốm Phù Lang</rdfs:label>
    <vn:name>gốm Phù Lang</vn:name>
    <vn:description xml:lang="vi">Hình ảnh chụp hai người phụ nữ trẻ đang trang trí một chiếc bình gốm lớn bằng cọ vẽ. Họ mặc trang phục truyền thống và đang làm việc trong một xưởng gốm, xung quanh là nhiều bình gốm khác nhau. Gốm Phù Lang thuộc làng gốm nổi tiếng ở Bắc Ninh, Việt Nam. Có một số biến thể về kỹ thuật và họa tiết, tùy thuộc vào từng nghệ nhân. Nghề gốm Phù Lang có lịch sử lâu đời, được truyền lại qua nhiều thế hệ. Kỹ thuật và phong cách trang trí đã được phát triển và biến đổi qua thời gian, nhưng vẫn giữ được nét đặc trưng riêng. Gốm Phù Lang vẫn được sản xuất và ưa chuộng, đóng góp vào nền kinh tế và du lịch của địa phương. Nhiều nghệ nhân trẻ đang nỗ lực kế thừa và phát triển nghề này. Hình ảnh này phản ánh nghề thủ công truyền thống của Việt Nam, góp phần bảo tồn và phát huy giá trị văn hóa phi vật thể. Sự kế thừa nghề gốm Phù Lang phản ánh sự nỗ lực của cộng đồng trong việc gìn giữ và phát triển bản sắc văn hóa dân tộc. Bảo tồn làng nghề truyền thống không chỉ giữ gìn di sản văn hoá vật thể mà còn bảo vệ di sản phi vật thể, là giá trị tinh thần quý báu của dân tộc. Gốm Phù Lang là một minh chứng sinh động cho sự kết hợp hài hòa giữa văn hoá truyền thống và sự đổi mới trong thời đại hiện nay. Nó đóng góp vào sự đa dạng và giàu có của văn hoá Việt Nam. Sự đa dạng về các loại gốm ở các vùng miền khác nhau phản ánh sự phong phú và đa dạng của văn hoá Việt Nam.</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
