  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_575b66d3f430acf0">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">đinh Đen Lu</rdfs:label>
    <vn:name>đinh Đen Lu</vn:name>
    <vn:description xml:lang="vi">Hình ảnh chụp một chiếc lư hương bằng đá, có kích thước lớn, được chạm khắc tinh xảo, đặt trên nền lát gạch ở một không gian ngoài trời có vẻ là sân nhà hoặc xưởng sản xuất. Được sử dụng phổ biến trên khắp cả nước, kiểu dáng và chất liệu có thể có sự khác biệt nhỏ giữa các vùng miền. Lư hương có lịch sử lâu đời, gắn liền với văn hóa Á Đông, được sử dụng trong các không gian thờ cúng từ nhiều thế kỷ nay. Vẫn được sử dụng trong các gia đình, chùa chiền, đền miếu, thể hiện sự tôn kính và lòng thành. Lư hương là vật phẩm không thể thiếu trong các không gian thờ cúng của người Việt, thể hiện lòng thành kính và sự tôn trọng đối với tổ tiên, thần linh. Hình ảnh phản ánh sự kết hợp giữa nghệ thuật điêu khắc và tín ngưỡng tâm linh trong văn hóa Việt. Việc sử dụng đá làm chất liệu thể hiện sự bền vững và tính trang nghiêm của đồ vật thờ cúng. Chiếc lư hương này không chỉ là đồ vật thờ cúng mà còn là một tác phẩm nghệ thuật, phản ánh sự kết hợp hài hòa giữa tín ngưỡng và nghệ thuật trong văn hóa Việt. Lư hương là một phần không thể thiếu trong đời sống tâm linh của người Việt, phản ánh mối quan hệ giữa con người với tổ tiên, thần linh và tự nhiên. Sự tồn tại của những lư hương như thế này cho thấy sự kế thừa và phát triển của nghệ thuật điêu khắc truyền thống. Sự đa dạng này phản ánh tính đa dạng văn hóa của Việt Nam, sự thích nghi và phát triển của nghệ thuật điêu khắc truyền thống trong từng bối cảnh địa phương.</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
