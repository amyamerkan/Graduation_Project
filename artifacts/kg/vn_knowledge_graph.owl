    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">Bộ Chỉ huy quân sự tỉnh Thái Bình</rdfs:label>
    <vn:name>Bộ Chỉ huy quân sự tỉnh Thái Bình</vn:name>
    <vn:sourceName>Vimuseum_QA</vn:sourceName>
    <vn:sourceRecordId>1e25bdb7aef39910ad99c2ab685bca6b14fcde966ca3e49ea816938b40bfc3d2</vn:sourceRecordId>
