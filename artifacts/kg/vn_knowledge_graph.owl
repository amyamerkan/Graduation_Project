  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/ward_a6ae6150c4f78e0f">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Ward"/>
    <rdfs:label xml:lang="vi">Xã Mỹ Lý</rdfs:label>
    <vn:name>Xã Mỹ Lý</vn:name>
    <vn:code>16816</vn:code>
    <vn:description xml:lang="vi">Hợp nhất toàn bộ; diện tích mới 211.03 km²</vn:description>
