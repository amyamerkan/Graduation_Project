  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/ward_499bd6d77ad29520">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Ward"/>
    <rdfs:label xml:lang="vi">Xã Quảng Yên</rdfs:label>
    <vn:name>Xã Quảng Yên</vn:name>
    <vn:code>08173</vn:code>
    <vn:description xml:lang="vi">Hợp nhất toàn bộ; diện tích mới 39.58 km²</vn:description>
    <vn:validFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-07-01</vn:validFrom>
