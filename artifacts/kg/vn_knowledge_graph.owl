  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/museum_f8d1c8d59ae91e61">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Museum"/>
    <rdfs:label xml:lang="vi">Vỏ chăn thấm tình đồng đội</rdfs:label>
    <vn:name>Vỏ chăn thấm tình đồng đội</vn:name>
    <vn:description xml:lang="vi">Chiếc vỏ chăn được ông Đỗ Văn Chiến dùng để phủ lên thi thể không vẹn toàn của ba đồng đội thuộc Tổ đài 15W bị bom Mỹ đánh trúng, sau đó giặt sạch tiếp tục sử dụng như một tấm bùa hộ mệnh suốt chiến tranh.</vn:description>
    <vn:sourceName>Vimuseum_QA</vn:sourceName>
    <vn:sourceRecordId>5e342714100f8637b507ece206f03dde45551cc4dc3516f36b0195713cc89e75</vn:sourceRecordId>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_82a8406a1965ed35">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">đua thuyen rồng Việt Nam</rdfs:label>
    <vn:name>đua thuyen rồng Việt Nam</vn:name>
    <vn:description xml:lang="vi">Hình ảnh chụp từ góc cao, cho thấy một cuộc đua thuyền rồng đang chuẩn bị diễn ra tại một địa điểm ven sông ở Việt Nam. Nhiều thuyền rồng với màu sắc sặc sỡ được sắp xếp dọc theo bờ sông, mỗi thuyền chở một đội chèo gồm nhiều người mặc áo phao màu sắc đồng bộ. Bên bờ, một đám đông lớn đang theo dõi và cổ vũ. Có các cờ Tổ quốc và nhiều băng rôn, cờ hiệu khác. Đua thuyền rồng phổ biến khắp Việt Nam, nhưng thường có những biến thể về hình thức và quy mô tùy theo vùng miền. Miền Nam thường có các lễ hội đua thuyền lớn và hoành tráng hơn. Đua thuyền rồng có nguồn gốc lâu đời, gắn liền với tín ngưỡng và truyền thuyết dân gian của người Việt. Truyền thống này được duy trì và phát triển qua nhiều thế hệ. Đua thuyền rồng vẫn được tổ chức thường xuyên trong các lễ hội, ngày hội thể thao, góp phần bảo tồn và phát huy giá trị văn hóa truyền thống, đồng thời thu hút du lịch và sự tham gia của cộng đồng. Đua thuyền rồng là một nét văn hóa đặc sắc, thể hiện tinh thần đoàn kết, sức mạnh và sự khéo léo của người dân Việt Nam. Sự kết hợp giữa các yếu tố: thuyền rồng, người chèo, khán giả, cờ Tổ quốc cho thấy đây là một sự kiện quan trọng, mang ý nghĩa về văn hoá và tinh thần cộng đồng. Truyền thống đua thuyền rồng phản ánh quan niệm về cộng đồng, sức mạnh tập thể và sự gắn bó mật thiết với thiên nhiên trong văn hóa Việt Nam. Việc duy trì và phát triển truyền thống đua thuyền rồng góp phần làm phong phú thêm đời sống văn hóa tinh thần của người Việt, khẳng định bản sắc văn hóa dân tộc. Sự đa dạng này phản ánh sự phong phú và đa dạng văn hoá của Việt Nam, cho thấy khả năng thích ứng và phát triển của một truyền thống lâu đời. đua thuyen rồng Việt Nam</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
    <vn:sourceRecordId>00e993f58467854c6df025575818ddaf928d8d3bda326787a799c1abbc30ff8e</vn:sourceRecordId>
    <vn:sourceRecordId>0a863e2199aea461b52879b59fd46851206ed571424978631b8d0289d3e5a347</vn:sourceRecordId>
    <vn:sourceRecordId>0b9c80d2afa693f1bdda3220706cfb2c7c3949fbe648e40598ad5ac0d37a495c</vn:sourceRecordId>
    <vn:sourceRecordId>0cf33d934f57c4329ef2254a4ac30cbf03c123f61caa8c1766bcf4148189a7a1</vn:sourceRecordId>
