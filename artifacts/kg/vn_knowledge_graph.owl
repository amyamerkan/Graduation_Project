  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_c90451c69472c052">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">Trần Đăng Ninh</rdfs:label>
    <vn:name>Trần Đăng Ninh</vn:name>
    <vn:sourceName>Vimuseum_QA</vn:sourceName>
