  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_f5c23544a3679d86">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">võ Tây Sơn</rdfs:label>
    <vn:name>võ Tây Sơn</vn:name>
    <vn:description xml:lang="vi">Hình ảnh chụp một nhóm người biểu diễn nhạc cụ truyền thống trên sân khấu. Bối cảnh được trang trí với tranh sơn mài mô tả cảnh quan thiên nhiên Việt Nam. Không thể xác định vùng miền cụ thể dựa trên hình ảnh, nhưng trang phục và nhạc cụ có thể thấy ở nhiều vùng miền khác nhau của Việt Nam Hình thức biểu diễn âm nhạc truyền thống có lịch sử lâu đời ở Việt Nam, liên quan đến nghi lễ, tín ngưỡng và sinh hoạt cộng đồng. Các loại trống được sử dụng trong nhiều dịp lễ hội khác nhau. Vẫn được duy trì và biểu diễn trong các sự kiện văn hóa, lễ hội, góp phần bảo tồn và quảng bá văn hóa Việt Nam. Hình ảnh phản ánh sự phong phú của văn hóa âm nhạc truyền thống Việt Nam, một phần quan trọng trong đời sống tinh thần của người Việt. Việc bảo tồn và phát huy các hình thức biểu diễn này có ý nghĩa to lớn trong việc gìn giữ bản sắc văn hóa dân tộc. Sự kết hợp giữa trang phục và nhạc cụ truyền thống tạo nên một bức tranh văn hóa sống động, phản ánh sự tinh tế trong nghệ thuật biểu diễn của người Việt. Đây là một minh chứng cho sự nỗ lực trong việc bảo tồn và phát triển văn hóa phi vật thể của Việt Nam, góp phần làm phong phú thêm đời sống tinh thần của người dân. Việc bảo tồn và phát huy các giá trị văn hoá truyền thống là một phần không thể thiếu trong việc xây dựng và phát triển đất nước, tạo nên sức mạnh đại đoàn kết dân tộc. Sự đa dạng về trang phục và nhạc cụ là minh chứng cho sự phong phú và đa dạng văn hoá của Việt Nam, phản ánh điều kiện địa lý, lịch sử và lối sống khác nhau giữa các vùng miền.</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
