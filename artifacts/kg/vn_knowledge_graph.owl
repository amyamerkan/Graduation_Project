  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_f8242d26fdc1d1e8">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">Dũng sĩ diệt Mỹ</rdfs:label>
    <vn:name>Dũng sĩ diệt Mỹ</vn:name>
    <vn:sourceName>Vimuseum_QA</vn:sourceName>
