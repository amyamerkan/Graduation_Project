  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/museum_e610f1b764fe5356">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Museum"/>
    <rdfs:label xml:lang="vi">Lá thư của vợ “liệt sỹ” trở về</rdfs:label>
    <vn:name>Lá thư của vợ “liệt sỹ” trở về</vn:name>
    <vn:description xml:lang="vi">Điều đặc biệt là người vợ viết thư động viên đơn vị quyết tâm chiến đấu trả thù cho chồng, nhưng may mắn thay người chồng “liệt sĩ” sau đó đã bình an trở về và tiếp tục chiến đấu.</vn:description>
    <vn:sourceName>Vimuseum_QA</vn:sourceName>
    <vn:sourceRecordId>27c298fcdb928c273d63891aadf0d1ce91f65f2d550d54fd693fac28cd646c3f</vn:sourceRecordId>
