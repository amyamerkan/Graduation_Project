  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_8084589732a6f17a">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">USD</rdfs:label>
