  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_0a9f5b41275e3965">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">nhảy sạp</rdfs:label>
    <vn:name>nhảy sạp</vn:name>
    <vn:description xml:lang="vi">Hình ảnh ghi lại cảnh biểu diễn nhảy sạp của một nhóm người, có vẻ như là trong một buổi lễ hoặc chương trình văn nghệ. Những người tham gia mặc trang phục truyền thống, đứng trên sân khấu có sàn được trang trí với các ô màu đỏ và trắng, tạo thành lối đi. Nhảy sạp phổ biến rộng rãi khắp Việt Nam, nhưng có thể có những biến thể về trang phục và cách thức biểu diễn tùy theo từng vùng miền. Nhảy sạp là trò chơi dân gian có lịch sử lâu đời, gắn liền với đời sống văn hóa cộng đồng của người Việt. Nó thể hiện sự khéo léo, sự phối hợp nhịp nhàng và tinh thần đoàn kết. Nhảy sạp vẫn được lưu giữ và phát huy, thường xuất hiện trong các lễ hội, chương trình văn nghệ, nhằm quảng bá văn hóa truyền thống và góp phần bảo tồn di sản văn hóa phi vật thể. Nhảy sạp không chỉ là một trò chơi giải trí mà còn là một hoạt động thể hiện tinh thần đoàn kết cộng đồng, khéo léo, sự uyển chuyển trong từng bước nhảy. Nó là một phần không thể thiếu của văn hóa Việt Nam. Việc tổ chức biểu diễn nhảy sạp thể hiện sự nỗ lực bảo tồn và phát huy các giá trị văn hoá truyền thống của người Việt, góp phần làm giàu thêm đời sống văn hoá tinh thần của cộng đồng. Trang phục là một phần không thể thiếu, phản ánh sự đầu tư và tôn trọng đối với trò chơi dân gian. Sự lựa chọn màu sắc và kiểu dáng thể hiện sự hiểu biết và gìn giữ nét đẹp văn hoá truyền thống. Nhảy sạp đóng vai trò quan trọng trong việc bảo tồn và phát huy giá trị văn hóa truyền thống, thúc đẩy sự gắn kết cộng đồng và tạo ra sự đa dạng trong đời sống văn hoá. Sự khác biệt này làm nổi bật lên tính cộng đồng và tính nghệ thuật trong nhảy sạp, giúp nó trở nên đặc sắc trong bức tranh văn hóa Việt Nam.</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
