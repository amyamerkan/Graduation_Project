  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_02518dd2cfab9f22">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">ném ga bông</rdfs:label>
    <vn:name>ném ga bông</vn:name>
    <vn:description xml:lang="vi">Hình ảnh liên quan đến ném ga bông trong văn hóa Việt Nam ném ga bông có ý nghĩa quan trọng trong văn hóa Việt Nam Có truyền thống lâu đời trong văn hóa dân tộc Vẫn giữ vai trò quan trọng trong đời sống hiện đại ném ga bông không chỉ có giá trị thực tiễn mà còn mang ý nghĩa tâm linh, thể hiện bản sắc văn hóa dân tộc Việt Nam.</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
