  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_f1589003b657dd37">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">trang phục Ê Đê</rdfs:label>
    <vn:name>trang phục Ê Đê</vn:name>
    <vn:description xml:lang="vi">Hình ảnh chụp một phụ nữ trẻ người Ê Đê trong trang phục truyền thống. Cô ấy đang đứng trong một khu vườn xanh tươi, tay cầm một nhánh cây có hoa nhỏ. Đặc trưng cho văn hóa người Ê Đê, chủ yếu sinh sống tại Tây Nguyên, Việt Nam. Trang phục phản ánh truyền thống dệt may lâu đời của người Ê Đê, với họa tiết và màu sắc mang ý nghĩa văn hóa riêng biệt. Ngày nay, trang phục Ê Đê vẫn được nhiều người, đặc biệt là phụ nữ, mặc trong các lễ hội, sự kiện văn hóa hoặc để bảo tồn bản sắc dân tộc. Có sự pha trộn giữa truyền thống và hiện đại, nhiều mẫu mã được thiết kế lại cho phù hợp với cuộc sống đương đại. Hình ảnh này góp phần thể hiện sự đa dạng văn hóa của Việt Nam, đặc biệt là văn hóa của các dân tộc thiểu số. Trang phục phản ánh kỹ thuật dệt may truyền thống của người Ê Đê, thể hiện sự khéo léo và thẩm mỹ của người phụ nữ. Bảo tồn và phát huy giá trị văn hóa truyền thống của người Ê Đê và góp phần làm phong phú thêm bức tranh văn hóa đa dạng của Việt Nam. Là một biểu tượng của sự đa dạng văn hóa Việt Nam và góp phần vào phát triển kinh tế bền vững cho cộng đồng. Sự đa dạng trong trang phục truyền thống thể hiện sự phong phú về văn hoá của Việt Nam.</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
