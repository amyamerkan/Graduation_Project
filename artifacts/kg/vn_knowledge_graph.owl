  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_72708aaadeca6b35">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">đan T'rung</rdfs:label>
    <vn:name>đan T'rung</vn:name>
    <vn:description xml:lang="vi">Hình ảnh chụp cận cảnh một nhạc cụ dân tộc Việt Nam gọi là đàn T'rưng. Đàn được đặt trên giá đỡ bằng tre, tạo thành hình dáng tam giác. Đặc trưng của văn hóa Tây Nguyên, cụ thể là các dân tộc Bahnar, Jrai, Ede... Lịch sử lâu đời, gắn liền với đời sống tinh thần của người dân Tây Nguyên, được sử dụng trong các lễ hội, nghi lễ và sinh hoạt cộng đồng. Vẫn được sử dụng và bảo tồn, được đưa vào giảng dạy tại các trường nghệ thuật, đóng góp vào việc quảng bá văn hóa Việt Nam Đàn T'rưng là một phần quan trọng của văn hóa âm nhạc Tây Nguyên, phản ánh sự gắn bó mật thiết của người dân với thiên nhiên và cuộc sống cộng đồng. Sự đơn giản trong vật liệu và cấu tạo phản ánh triết lý sống gần gũi với thiên nhiên của người dân Tây Nguyên. Đàn T'rưng là biểu tượng của văn hóa Tây Nguyên, là di sản văn hóa phi vật thể quý báu cần được bảo tồn và phát huy. Đàn T'rưng là minh chứng cho sự giàu có và đa dạng của văn hóa Việt Nam, là một phần quan trọng trong nỗ lực bảo tồn và phát huy di sản văn hóa phi vật thể. Sự khác biệt này phản ánh sự đa dạng văn hóa và sự sáng tạo trong nghệ thuật chế tác nhạc cụ của người Việt.</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
    <vn:sourceRecordId>0637d7a80ca04c309eeaee5f5f62ab91d1b61455c1b73dac8667148654a89250</vn:sourceRecordId>
    <vn:sourceRecordId>07ca49edce843c7ef23f0393ec8fe5da1e51ebdf21c0636177d8fbdd320c1aae</vn:sourceRecordId>
    <vn:sourceRecordId>08b4393b3d961e063ab8ea8bd7d82da3f34987db27f670d3dc2a347910ba936d</vn:sourceRecordId>
