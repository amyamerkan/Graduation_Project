  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_82769a531912a059">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">buffalo fighting</rdfs:label>
    <vn:name>buffalo fighting</vn:name>
    <vn:description xml:lang="vi">Hình ảnh chụp cận cảnh cuộc đấu trâu, một trò chơi dân gian truyền thống của Việt Nam. Hai con trâu đen đang đối đầu nhau, trong khi đó, một lượng lớn khán giả đang theo dõi trận đấu từ trên khán đài. Trò chơi đấu trâu phổ biến ở nhiều vùng nông thôn Việt Nam, đặc biệt là ở miền Bắc và Trung Bộ, với những biến thể nhỏ tùy theo địa phương. Dấu tích của trò chơi đấu trâu đã xuất hiện từ lâu đời, gắn liền với đời sống nông nghiệp và tín ngưỡng của người Việt. Nó phản ánh sức mạnh, sự dũng mãnh và tinh thần thi đấu của con người. Ngày nay, đấu trâu vẫn được duy trì ở một số địa phương, trở thành một phần quan trọng trong các lễ hội, thu hút khách du lịch và góp phần bảo tồn văn hóa truyền thống. Đấu trâu không chỉ là trò chơi giải trí mà còn phản ánh mối quan hệ mật thiết giữa người Việt với con trâu - một biểu tượng của sức mạnh, sự cần cù và giàu có trong nông nghiệp. Đấu trâu không chỉ là trò chơi mà còn là dịp để mọi người tụ họp, giao lưu, thể hiện tinh thần cộng đồng và truyền tải giá trị văn hoá truyền thống. Trò chơi này còn mang ý nghĩa cầu mong mùa màng bội thu, sức khỏe và sự thịnh vượng cho cả làng xã. Việc duy trì trò chơi đấu trâu góp phần giữ gìn bản sắc văn hóa dân tộc và thúc đẩy sự phát triển kinh tế - xã hội ở các vùng nông thôn. Những khác biệt này phản ánh sự đa dạng văn hóa và thích nghi với điều kiện địa lý, kinh tế - xã hội của từng vùng miền.</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
