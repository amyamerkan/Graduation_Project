  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_25fcf9c1f359c557">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">Ca trù performance</rdfs:label>
    <vn:name>Ca trù performance</vn:name>
    <vn:description xml:lang="vi">Hình ảnh chụp một buổi lễ trao tặng danh hiệu Nghệ nhân nhân dân cho bà Nguyễn Thị Tam, một nghệ sĩ Ca trù. Bức ảnh ghi lại khoảnh khắc bà nhận bằng khen, đứng giữa các quan khách và một dàn nhạc cụ Ca trù. Ca trù là loại hình nghệ thuật đặc trưng của vùng đồng bằng Bắc Bộ, Việt Nam. Ca trù có lịch sử lâu đời, phát triển mạnh từ thế kỷ 15-19, từng là nghệ thuật cung đình, sau đó phổ biến trong dân gian. Danh hiệu Nghệ nhân nhân dân là sự ghi nhận cao nhất của Nhà nước đối với những người có đóng góp xuất sắc cho nghệ thuật truyền thống. Ca trù đang được bảo tồn và phát triển, thu hút sự quan tâm của giới trẻ và du khách quốc tế. Việc trao tặng danh hiệu này thể hiện sự nỗ lực bảo tồn di sản văn hóa phi vật thể của Việt Nam. Hình ảnh này phản ánh sự quan tâm của Nhà nước trong việc bảo tồn và phát huy các giá trị văn hoá truyền thống, đặc biệt là các loại hình nghệ thuật dân gian. Hình ảnh nhấn mạnh vai trò quan trọng của việc bảo tồn và phát huy các giá trị văn hoá truyền thống trong đời sống hiện đại. Hình ảnh này khẳng định tầm quan trọng của việc kế thừa và phát triển các loại hình nghệ thuật truyền thống, góp phần làm phong phú thêm bản sắc văn hoá dân tộc. Ca trù là một chứng tích lịch sử quý giá, thể hiện sự phát triển văn hoá Việt Nam qua các thời kỳ. Bảo tồn Ca trù là bảo tồn một phần ký ức collective của dân tộc. Sự đa dạng của các loại hình nghệ thuật truyền thống phản ánh sự phong phú và đa dạng của văn hoá Việt Nam.</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
