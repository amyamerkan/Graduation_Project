  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_7786424beaf68478">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">GPU</rdfs:label>
    <vn:name>GPU</vn:name>
    <vn:sourceName>Vimuseum_QA</vn:sourceName>
    <vn:sourceRecordId>510d924cb8f3b21ec6e6ccb24bcf6bb5e91f46bc5d92daaa18974cf798989b75</vn:sourceRecordId>
