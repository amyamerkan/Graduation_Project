  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_3259db56b5794e35">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">le hoi đen Hùng</rdfs:label>
    <vn:name>le hoi đen Hùng</vn:name>
    <vn:description xml:lang="vi">Hình ảnh chụp toàn cảnh cổng chính của Trung tâm Lễ hội Đền Hùng ở Phú Thọ, Việt Nam. Cổng được xây dựng theo kiến trúc truyền thống Á Đông, với sự kết hợp hài hòa giữa đá, gỗ và ngói. Cổng chính là biểu tượng của Trung tâm Lễ hội Đền Hùng, nơi tổ chức giỗ Tổ Hùng Vương, một lễ hội lớn nhất và quan trọng nhất của Việt Nam. Cổng được xây dựng gần đây, nhằm phục vụ cho việc tổ chức lễ hội Đền Hùng, nhưng kiến trúc lại mang đậm dấu ấn truyền thống, thể hiện sự kế thừa và phát huy giá trị văn hoá của dân tộc. Cổng là điểm nhấn kiến trúc, thu hút du khách trong và ngoài nước, góp phần quảng bá hình ảnh văn hóa Việt Nam. Cổng này là điểm nhấn kiến trúc quan trọng, đón tiếp du khách đến tham dự Lễ hội Đền Hùng, một sự kiện văn hóa lớn của cả nước. Sự kết hợp này phản ánh nỗ lực của Việt Nam trong việc gìn giữ di sản văn hoá phi vật thể và vật thể, đồng thời đáp ứng nhu cầu phát triển hiện đại của đất nước. Cổng là biểu tượng của lòng biết ơn, sự đoàn kết và tinh thần dân tộc, góp phần củng cố ý thức về nguồn gốc lịch sử và văn hoá của người Việt. Cổng đóng vai trò là biểu tượng quốc gia, thúc đẩy sự tự hào dân tộc và giáo dục thế hệ trẻ về lịch sử và văn hoá của đất nước. Sự khác biệt này phản ánh tầm quan trọng của Lễ hội Đền Hùng trong đời sống văn hoá và tinh thần của người Việt Nam.</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
