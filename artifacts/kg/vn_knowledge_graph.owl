  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_9f96f6c6bddb71fb">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">le hoi múa lân</rdfs:label>
    <vn:name>le hoi múa lân</vn:name>
    <vn:description xml:lang="vi">Hình ảnh chụp một đoàn người đang biểu diễn múa lân và rồng trong một lễ hội đường phố Việt Nam. Bối cảnh có nhiều đèn lồng đỏ, cho thấy đây có thể là dịp Tết Nguyên đán hoặc một lễ hội truyền thống khác. Múa lân phổ biến khắp Việt Nam, tuy nhiên, có thể có những biến thể nhỏ về trang phục và động tác biểu diễn giữa các vùng miền. Múa lân có nguồn gốc từ Trung Quốc, du nhập vào Việt Nam từ lâu đời và được Việt hóa qua nhiều thế hệ. Nó gắn liền với tín ngưỡng dân gian và thường được biểu diễn trong các dịp lễ Tết, cầu mong may mắn, xua đuổi tà ma. Múa lân vẫn được duy trì và phát triển trong đời sống hiện đại của người Việt, góp phần bảo tồn và quảng bá văn hóa truyền thống, thu hút khách du lịch. Múa lân và rồng là một phần không thể thiếu của văn hóa lễ hội Việt Nam, mang ý nghĩa cầu may, xua đuổi tà khí và tạo không khí vui tươi, náo nhiệt. Hoạt động này góp phần bảo tồn và phát huy giá trị văn hóa phi vật thể của dân tộc, mang lại niềm vui và sự gắn kết cho cộng đồng. Hình ảnh phản ánh một phần quan trọng của tín ngưỡng dân gian Việt Nam và sự kế thừa, phát triển văn hóa truyền thống trong đời sống hiện đại. Múa lân là một minh chứng cho sự bền bỉ và sức sống mãnh liệt của văn hóa Việt Nam qua bao thăng trầm lịch sử. Sự đa dạng này minh chứng cho sự phong phú và đa dạng của văn hóa Việt Nam.</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
    <vn:sourceRecordId>022f2d1d2ee2c87a969aa64fec6d117cc5ac2e00ebff511931c94a85079bae8b</vn:sourceRecordId>
    <vn:sourceRecordId>0a0b55f1e4323c6cca2ee3f1daf0e5a7cb69a14f208d07cdcf4c549b39f06b79</vn:sourceRecordId>
    <vn:sourceRecordId>16096ccc7b87285b21e26b81d73b325bf92fb1ced9e562808b43834d89523974</vn:sourceRecordId>
