  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_d17866ee77199de2">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">trống đồng</rdfs:label>
    <vn:name>trống đồng</vn:name>
    <vn:description xml:lang="vi">Hình ảnh chụp một chiếc trống đồng được trang trí cầu kỳ, được đặt trong khung hình vuông màu trắng viền vàng, trên tường. Trống đồng được làm nổi bật bởi nền trắng và viền vàng tạo sự sang trọng. Phát hiện nhiều nhất ở vùng châu thổ sông Hồng, nhưng ảnh hưởng văn hóa lan tỏa rộng khắp Đông Nam Á Thời kỳ văn hóa Đông Sơn (thế kỷ thứ III TCN - thế kỷ thứ I CN), biểu tượng cho quyền lực, tín ngưỡng và xã hội Biểu tượng quốc gia, được sử dụng trong các sự kiện văn hóa, lễ hội và trưng bày bảo tàng. Cảm hứng cho nhiều tác phẩm nghệ thuật hiện đại. Trống đồng là biểu tượng quan trọng của văn hóa Việt Nam, tượng trưng cho sức mạnh, quyền lực và sự thịnh vượng của cộng đồng. Việc trưng bày trống đồng phản ánh sự trân trọng và bảo tồn di sản văn hóa của người Việt Nam. Trống đồng là một bằng chứng quan trọng về sự phát triển văn minh của người Việt cổ và đóng góp vào kho tàng văn hoá phi vật thể của quốc gia. Trống đồng là một di sản văn hoá vô cùng quý giá, đóng góp vào việc khẳng định lịch sử và bản sắc văn hoá Việt Nam trên trường quốc tế. Sự độc đáo của trống đồng Đông Sơn góp phần khẳng định tính độc lập và bản sắc văn hoá riêng biệt của người Việt cổ.</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
