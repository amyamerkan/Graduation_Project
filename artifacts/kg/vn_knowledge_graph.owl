  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_1a14269b186428fd">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">múa lân trẻ em</rdfs:label>
    <vn:name>múa lân trẻ em</vn:name>
    <vn:description xml:lang="vi">Hình ảnh chụp cận cảnh hai mặt của một bộ đầu lân dành cho trẻ em, được thiết kế với màu sắc tươi sáng và chất liệu mềm mại. Múa lân phổ biến khắp Việt Nam nhưng có thể có những biến thể nhỏ về màu sắc, kiểu dáng tùy theo vùng miền. Múa lân có nguồn gốc từ Trung Quốc, du nhập vào Việt Nam từ lâu đời và được Việt hóa qua nhiều thế kỷ, trở thành một phần không thể thiếu của văn hóa Việt. Múa lân vẫn được duy trì và phát triển, đặc biệt là trong các lễ hội, sự kiện văn hóa, tạo không khí vui tươi và may mắn. Múa lân tượng trưng cho sự may mắn, thịnh vượng và xua đuổi tà ma trong văn hóa Việt Nam. Nó thường xuất hiện trong các dịp lễ hội, đặc biệt là Tết Nguyên Đán. Hình ảnh cho thấy sự kế thừa và phát triển của truyền thống văn hóa múa lân, lan tỏa đến thế hệ trẻ. Giúp bảo tồn và phát huy truyền thống múa lân, một phần quan trọng trong văn hoá Việt Nam. Múa lân là một di sản văn hóa phi vật thể quý giá của Việt Nam, phản ánh bản sắc văn hóa độc đáo và sức sống bền bỉ của dân tộc. Sự đa dạng về hình thức của đầu lân phản ánh sự phong phú và đa dạng của văn hóa Việt Nam.</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
