  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/museum_9ba38b00989a8da9">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Museum"/>
    <rdfs:label xml:lang="vi">Sổ nhật ký hành quân của Trung tướng Nguyễn Tiến Bình</rdfs:label>
    <vn:name>Sổ nhật ký hành quân của Trung tướng Nguyễn Tiến Bình</vn:name>
    <vn:description xml:lang="vi">Đây là hai cuốn sổ nhật ký hành quân của Trung tướng, PGS.TS Nguyễn Tiến Bình, ghi chép trong thời gian tham gia chiến đấu ở chiến trường Campuchia và mặt trận Sài Gòn – Gia Định từ năm 1970 đến năm 1975.</vn:description>
    <vn:sourceName>Vimuseum_QA</vn:sourceName>
