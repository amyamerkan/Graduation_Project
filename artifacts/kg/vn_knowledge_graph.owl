  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_4b319fb708d58c80">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">trang phục Cơ Tu</rdfs:label>
    <vn:name>trang phục Cơ Tu</vn:name>
    <vn:description xml:lang="vi">Hình ảnh chụp hai người mẫu trẻ, một nam và một nữ, đang trình diễn trang phục được thiết kế lấy cảm hứng từ văn hóa dân tộc Cơ Tu, trên một sân khấu trình diễn thời trang. Trang phục được làm từ chất liệu tái chế, chủ yếu là giấy hoặc vải tái sử dụng, tạo nên vẻ ngoài độc đáo và sáng tạo. Văn hóa Cơ Tu thuộc vùng Tây Nguyên, Việt Nam. Trang phục truyền thống Cơ Tu thường đơn giản, gần gũi với thiên nhiên, nhưng thiết kế này mang tính cách tân. Trang phục Cơ Tu truyền thống có lịch sử lâu đời gắn liền với đời sống sinh hoạt và tín ngưỡng của người Cơ Tu. Thiết kế này là một sự sáng tạo hiện đại, dựa trên cảm hứng từ truyền thống. Sự kết hợp giữa truyền thống và hiện đại trong thiết kế thời trang, góp phần quảng bá văn hóa Cơ Tu đến công chúng rộng rãi. Hình ảnh cho thấy sự nỗ lực trong việc bảo tồn và phát huy giá trị văn hóa truyền thống của Việt Nam, bằng cách kết hợp các yếu tố văn hóa vào thiết kế thời trang. Thiết kế cho thấy sự kết hợp hài hòa giữa yếu tố truyền thống và hiện đại, thể hiện sự tôn trọng và sáng tạo dựa trên nền tảng văn hóa Cơ Tu. Đây là ví dụ điển hình của việc ứng dụng văn hóa truyền thống vào lĩnh vực thời trang hiện đại, góp phần bảo tồn và phát huy giá trị văn hóa dân tộc. Sự kết hợp giữa bảo tồn văn hóa và bảo vệ môi trường tạo nên giá trị nhân văn sâu sắc, thể hiện trách nhiệm cộng đồng. Sự kết hợp giữa truyền thống và hiện đại trong thiết kế thời trang cho thấy sự nỗ lực trong việc bảo tồn và phát huy di sản văn hóa, đồng thời tạo ra sự mới mẻ, thu hút sự quan tâm của công chúng.</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
