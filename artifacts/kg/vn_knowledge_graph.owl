  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/heritage_ff0bb84f0808bb02">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Heritage"/>
    <rdfs:label xml:lang="vi">trống Việt Nam</rdfs:label>
    <vn:name>trống Việt Nam</vn:name>
    <vn:description xml:lang="vi">Hình ảnh chụp cận cảnh một chiếc trống djembe, một loại trống truyền thống của người dân tộc ở Tây Phi, không phải là trống truyền thống của Việt Nam. Không có ý nghĩa vùng miền đối với văn hóa Việt Nam. Djembe có nguồn gốc và ý nghĩa văn hoá sâu sắc trong các nền văn hoá Tây Phi. Trống djembe có lịch sử lâu đời ở Tây Phi, được sử dụng trong các nghi lễ, lễ hội và âm nhạc dân gian. Trống djembe hiện nay được sử dụng rộng rãi trên toàn thế giới như một nhạc cụ biểu diễn và giáo dục âm nhạc. Ở Tây Phi, djembe không chỉ là nhạc cụ mà còn là một phần không thể thiếu trong đời sống văn hóa, tâm linh và cộng đồng. Nó được sử dụng trong các buổi lễ, lễ hội, và các hoạt động xã hội. Sự kết hợp giữa gỗ và da thể hiện sự hài hòa giữa thiên nhiên và con người trong quan niệm của nhiều dân tộc Tây Phi. Không có ý nghĩa văn hóa đối với Việt Nam Sự so sánh nhấn mạnh sự đa dạng của nhạc cụ trên thế giới và tầm quan trọng của việc hiểu bối cảnh văn hoá khi nghiên cứu các vật thể.</vn:description>
    <vn:sourceName>viet-cultural-vqa</vn:sourceName>
