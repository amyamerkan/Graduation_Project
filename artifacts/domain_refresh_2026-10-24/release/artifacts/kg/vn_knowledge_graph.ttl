@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix res: <https://w3id.org/vn-assistant/resource/> .
@prefix vn: <https://w3id.org/vn-assistant/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/vn-assistant/ontology> a owl:Ontology ;
    dct:description "Lược đồ OWL cho Knowledge Graph của trợ lý ảo Việt Nam."@vi ;
    dct:title "Vietnam Heritage, Tourism and Administration Ontology"@en,
        "Ontology di sản, du lịch và hành chính Việt Nam"@vi ;
    owl:versionInfo "1.0.0" .

vn:AdministrativeProcedure a owl:Class ;
    rdfs:label "Thủ tục hành chính"@vi ;
    rdfs:subClassOf vn:LegalEntity .

vn:HeritageSite a owl:Class ;
    rdfs:label "Di tích hoặc địa điểm di sản"@vi ;
    rdfs:subClassOf vn:TangibleHeritage .

vn:IntangibleHeritage a owl:Class ;
    rdfs:label "Di sản phi vật thể"@vi ;
    rdfs:subClassOf vn:Heritage .

vn:Museum a owl:Class ;
    rdfs:label "Bảo tàng"@vi ;
    rdfs:subClassOf vn:Heritage .

vn:TourismActivity a owl:Class ;
    rdfs:label "Hoạt động du lịch"@vi ;
    rdfs:subClassOf vn:TourismEntity .

vn:WorldHeritage a owl:Class ;
    rdfs:label "Di sản thế giới"@vi ;
    rdfs:subClassOf vn:Heritage .

vn:address a owl:DatatypeProperty ;
    rdfs:label "địa chỉ do nguồn ghi nhận"@vi ;
    rdfs:domain vn:TourismPlace ;
    rdfs:range xsd:string .

vn:code a owl:DatatypeProperty ;
    rdfs:label "mã"@vi ;
    rdfs:domain vn:Entity ;
    rdfs:range xsd:string .

vn:contains a owl:ObjectProperty ;
    rdfs:label "chứa"@vi ;
    rdfs:domain vn:AdministrativeUnit ;
    rdfs:range vn:Entity ;
    owl:inverseOf vn:locatedIn .

vn:description a owl:DatatypeProperty ;
    rdfs:label "mô tả"@vi ;
    rdfs:domain vn:Entity ;
    rdfs:range xsd:string .

vn:governedBy a owl:ObjectProperty ;
    rdfs:label "do cơ quan quản lý"@vi ;
    rdfs:domain vn:LegalEntity ;
    rdfs:range vn:Organization .

vn:hasArticle a owl:ObjectProperty ;
    rdfs:label "có điều luật"@vi ;
    rdfs:domain vn:LegalDocument ;
    rdfs:range vn:LegalArticle .

vn:hasSource a owl:ObjectProperty ;
    rdfs:label "có nguồn"@vi ;
    rdfs:domain vn:Entity ;
    rdfs:range vn:SourceDocument .

vn:inscriptionYear a owl:DatatypeProperty ;
    rdfs:label "năm ghi danh"@vi ;
    rdfs:domain vn:Heritage ;
    rdfs:range xsd:gYear .

vn:isCurrentSnapshot a owl:DatatypeProperty ;
    rdfs:label "phiên bản danh mục hiện tại của ứng dụng"@vi ;
    rdfs:domain vn:AdministrativeUnit ;
    rdfs:range xsd:boolean .

vn:latitude a owl:DatatypeProperty ;
    rdfs:label "vĩ độ"@vi ;
    rdfs:domain vn:Entity ;
    rdfs:range xsd:decimal .

vn:longitude a owl:DatatypeProperty ;
    rdfs:label "kinh độ"@vi ;
    rdfs:domain vn:Entity ;
    rdfs:range xsd:decimal .

vn:mentions a owl:ObjectProperty ;
    rdfs:label "đề cập"@vi ;
    rdfs:domain vn:SourceDocument ;
    rdfs:range vn:Entity .

vn:mergedInto a owl:ObjectProperty ;
    rdfs:label "sáp nhập vào"@vi ;
    rdfs:domain vn:AdministrativeUnit ;
    rdfs:range vn:AdministrativeUnit .

vn:name a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "tên"@vi ;
    rdfs:domain vn:Entity ;
    rdfs:range xsd:string .

vn:partlyMergedInto a owl:ObjectProperty ;
    rdfs:label "chuyển một phần địa bàn vào"@vi ;
    rdfs:domain vn:AdministrativeUnit ;
    rdfs:range vn:AdministrativeUnit .

vn:recognizedBy a owl:ObjectProperty ;
    rdfs:label "được công nhận bởi"@vi ;
    rdfs:domain vn:Heritage ;
    rdfs:range vn:Organization .

vn:reorganizedInto a owl:ObjectProperty ;
    rdfs:label "liên kết chuyển đổi danh mục"@vi ;
    rdfs:domain vn:AdministrativeUnit ;
    rdfs:range vn:AdministrativeUnit .

vn:replacedBy a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "được thay thế bởi"@vi ;
    rdfs:domain vn:Entity ;
    rdfs:range vn:Entity .

vn:snapshotDate a owl:DatatypeProperty ;
    rdfs:label "ngày chụp danh mục"@vi ;
    rdfs:domain vn:AdministrativeUnit ;
    rdfs:range xsd:date .

vn:sourceName a owl:DatatypeProperty ;
    rdfs:label "tên nguồn"@vi ;
    rdfs:domain vn:Entity ;
    rdfs:range xsd:string .

vn:sourceRecordId a owl:DatatypeProperty ;
    rdfs:label "mã bản ghi nguồn"@vi ;
    rdfs:domain vn:Entity ;
    rdfs:range xsd:string .

vn:sourceUrl a owl:DatatypeProperty ;
    rdfs:label "URL nguồn"@vi ;
    rdfs:domain vn:SourceDocument ;
    rdfs:range xsd:anyURI .

vn:validFrom a owl:DatatypeProperty ;
    rdfs:label "có hiệu lực từ"@vi ;
    rdfs:domain vn:Entity ;
    rdfs:range xsd:date .

vn:validTo a owl:DatatypeProperty ;
    rdfs:label "có hiệu lực đến"@vi ;
    rdfs:domain vn:Entity ;
    rdfs:range xsd:date .

