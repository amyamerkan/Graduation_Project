  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_3607dd64da20a055">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Di tích Mộ bà Hoàng Thị Loan</rdfs:label>
    <vn:name>Di tích Mộ bà Hoàng Thị Loan</vn:name>
    <vn:description xml:lang="vi">Mộ bà Hoàng Thị Loan: tọa lạc trên lưng chừng núi Động Tranh, trong dãy Đại Huệ, thuộc địa phận xã Nam Giang. Mộ được ốp đá hoa cương, bên trên che mái dốc, phía trước sân dựng một tấm bia bằng đá đen, ghi lại tiểu sử và công lao của bà... Ở làng Sen xưa có phần mộ của cụ Hoàng Thị Loan – thân mẫu của Bác. Năm 1942, ông Nguyễn Sinh Khiêm (anh ruột của Bác) đã đưa hài cốt cụ bà an táng tại núi Động Tranh, cách làng Sen 5km. Từ chân núi leo lên khoảng 300 bậc đá là phần mộ của cụ bà (người dân Nghệ An đã xây lại phần mộ vào năm 1985). Phần mái che được xây bằng bê tông cách điệu như hình chiếc khung cửi – thuở sinh thời thân mẫu của Bác vẫn dệt cửi để nuôi con.</vn:description>
    <vn:address>Tọa lạc trên lưng chừng núi Động Tranh, Huyện Nam Đàn, Nghệ An</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=1004</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_3607dd64da20a055</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_c542104fcb9db648"/>
  </rdf:Description>
