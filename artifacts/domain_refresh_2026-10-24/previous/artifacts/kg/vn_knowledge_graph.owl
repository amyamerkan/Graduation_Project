  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_42cd5fe47f7a097a">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Động Tiên Sơn</rdfs:label>
    <vn:name>Động Tiên Sơn</vn:name>
    <vn:description xml:lang="vi">Động Tiên Sơn nằm trong quần thể khu du lịch sinh thái Hàm Rồng, tại làng Đông Sơn, phường Hạc Thành, tỉnh Thanh Hoá. Động Tiên Sơn nằm trong lòng núi đá vôi với 3 hang động thông nhau. Nơi đây được ví như Đệ nhất động của xứ Thanh, đồng thời cũng thuộc top đẹp hàng đầu Việt Nam. Xung quanh bao bọc bởi cảnh quan thiên nhiên hoang sơ, đặc biệt là lúc nào cũng rực rỡ sắc hoa quyến rũ. Đến địa điểm du lịch Thanh Hoá nổi tiếng này bạn sẽ được chiêm ngưỡng một quần thể những khối nhũ đá độc đáo hình toà sen, Quan Thế Âm Bồ Tát, tượng Ông bụt,.... Ngay giữa chính cung là khối đá của Bạch Tiên Nương, đền thờ Bà Chúa Kho với sau lưng là những khối đá hình ruộng bậc thang, kho vàng,... rực rỡ.</vn:description>
    <vn:address>, Hàm Rồng, Thanh Hoá</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=1282</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_42cd5fe47f7a097a</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_3d86d1f4989b8999"/>
  </rdf:Description>
