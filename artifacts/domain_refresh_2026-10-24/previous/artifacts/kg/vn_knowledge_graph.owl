  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_d0a39b6364c1cee4">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Vườn cò Hải Lựu</rdfs:label>
    <vn:name>Vườn cò Hải Lựu</vn:name>
    <vn:description xml:lang="vi">Vườn cò Hải Lựu được coi là một trong 5 khu rừng sinh thái nổi tiếng tại Vĩnh Phúc. Không rộng lớn như vườn quốc gia Tam Đảo, không quá hoang sơ như Hồ Đại Lải… Vườn cò Hải Lựu mang một nét rất riêng, rất thơ mộng và rất đỗi bình yên. Đến với vườn cò Hải Lựu du khách sẽ được đắm chìm trong khung cảnh thiên nhiên xinh đẹp. Vườn cò Hải Lựu thuộc thôn Dừa Lễ, xã Hải Lựu, huyện Sông Lô, tỉnh Vĩnh Phúc, cách trung tâm Hà Nội 110km. Vườn cò được bao bọc bởi dòng sông Lô hiền hòa, êm ả. Vườn cò là một khu sinh thái còn sót lại trên nền rừng Hải Lựu. Khu vườn có diện tích khoảng 15ha, trong đó có đến 7ha là nơi chim cò hội tụ, sinh sống. Nhiệt độ hàng năm của vườn cò Hải Lựu thay đổi theo mùa, nhiệt độ trung bình là 28ºC và lượng mưa trung bình là hàng năm là 1.650mm. Đến đây, du khách sẽ được khám phá vô số loài chim, cò quý hiếm. Có thể kể đến một số loài như: cò ruồi, có lửa, cò xanh, cò bợ, cò lùn… và một số loài chim như chào mào, sáo sậu… Hơn thế nữa, vườn cò Hải Lựu còn phong phú bởi những loại cây khác nhau như tre, xoan, trẩu, sung, nhãn… Đây là những loại cây mà đàn chim, cò thường tìm về để làm tổ.</vn:description>
    <vn:address>thôn Dừa Lễ, Hải Lựu, Huyện Sông Lô, Vĩnh Phúc</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=1039</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_d0a39b6364c1cee4</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_af7419713db145c1"/>
  </rdf:Description>
