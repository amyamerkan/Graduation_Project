  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_e4494f1ece55835e">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Khu bảo tồn thiên nhiên Pù Luông</rdfs:label>
    <vn:name>Khu bảo tồn thiên nhiên Pù Luông</vn:name>
    <vn:description xml:lang="vi">Khu bảo tồn thiên nhiên Pù Luông (thành lập năm 1999) có diện tích 17.662 ha, nằm trên địa bàn 2 huyện Quan Hóa và Bá Thước, tỉnh Thanh Hóa, cách Hà Nội khoảng 210 km và thành phố Thanh Hóa 130 km. Trong tiếng Thái, "Pù Luông" nghĩa là đỉnh núi cao nhất vùng. Nơi đây kết nối với Vườn quốc gia Cúc Phương qua hai dãy núi đá vôi song song và cùng với khu bảo tồn Pù Hu đóng vai trò quan trọng trong việc phòng hộ đầu nguồn sông Mã. Pù Luông sở hữu hệ sinh thái rừng kín nhiệt đới thường xanh trên địa hình núi đá vôi karst cùng vô số hang động đẹp (như hang Dơi Kho Mường). Khu bảo tồn có hệ động - thực vật đa dạng với hàng trăm loài, trong đó có nhiều loài quý hiếm và đặc hữu như voọc quần đùi trắng, báo gấm, sơn dương, gấu ngựa... Với vẻ đẹp hoang sơ, thơ mộng ẩn hiện trong sương cùng những ruộng lúa bậc thang trải dài, Pù Luông là điểm đến hấp dẫn cho du khách thích trekking, phượt và nghỉ dưỡng. Các địa danh nổi tiếng tại đây gồm: đỉnh Pù Luông, Son Bá Mười, Kho Mường, làng Đôn, thác Hiêu... Nơi đây cũng kết nối thuận tiện với các điểm du lịch lân cận như Mai Châu, suối Cá Thần, di sản Thành nhà Hồ.</vn:description>
    <vn:address>Pù Luông, Bá Thước, Thanh Hoá</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=1280</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_e4494f1ece55835e</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_3d86d1f4989b8999"/>
  </rdf:Description>
