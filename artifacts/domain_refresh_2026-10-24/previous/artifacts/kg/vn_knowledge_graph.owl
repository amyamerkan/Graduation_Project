  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_7278e61c2216953f">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Vườn trái cây Gò Chùa</rdfs:label>
    <vn:name>Vườn trái cây Gò Chùa</vn:name>
    <vn:description xml:lang="vi">Nhắc đến miền Nam Bộ, ai cũng nghĩ đến những vườn trái cây tươi ngon bậc nhất và Tây Ninh cũng không phải là miền đất ngoại lệ. Vườn trái cây Gò Chùa nơi đây là một điểm đến được rất nhiều người ưa chuộng vì đến đây, ngoài được tham quan những vườn trồng hoa quả rộng lớn thì bạn còn được thử ngay “tại trận” vị tươi ngon, mát lòng mát dạ của các loại trái cây nơi đây. Sự đôn hậu và nhiệt tình, thoải mái của người dân ở những khu vườn trái cây này cũng là điểm sẽ khiến bạn nhớ mãi không thôi những khu vườn trái cây tươi ngon. Ngoài ra, bạn cũng có thể tự tay lựa chọn trái cây mua về làm quà cho người thân ở nhà.</vn:description>
    <vn:address>22B, Gò Dầu, Gò Dầu, Huyện Gò Dầu</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=1102</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_7278e61c2216953f</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_7c63c67cd1ebe40b"/>
  </rdf:Description>
