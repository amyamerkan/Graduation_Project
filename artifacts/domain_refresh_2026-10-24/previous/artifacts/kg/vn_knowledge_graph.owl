  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_f6ee4d94eb4d24d6">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Thác A Dơi</rdfs:label>
    <vn:name>Thác A Dơi</vn:name>
    <vn:description xml:lang="vi">Ngọn thác tự nhiên mang vẻ đẹp hoang sơ, gồm nhiều tầng nước chảy qua các ghềnh đá tại Hướng Hóa, Quảng Trị. Cách ngã ba Tân Long khoảng 30 km theo tuyến đường Hướng Hóa - tuyến Lìa. Đường vào đang được đầu tư nâng cấp, có đoạn còn là đường đất và cần leo trèo nhẹ để xuống chân thác. Mang vẻ đẹp thuần khiết, chưa bị thương mại hóa nhiều, không gian thoáng đãng và là điểm giải nhiệt lý tưởng giữa đại ngàn vùng biên giới.</vn:description>
    <vn:address>CQJC+M97, A Dơi, Quảng Trị</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=1278</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_f6ee4d94eb4d24d6</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_87fdcd5b2e3d3a7d"/>
  </rdf:Description>
