  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_7cf4bdb09a1ecc38">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Thác Chín Tầng</rdfs:label>
    <vn:name>Thác Chín Tầng</vn:name>
    <vn:description xml:lang="vi">Thác chín tầng thuộc xã Ia Bă, cách trung tâm huyện Ia Grai khoảng 16 km, cách TP. Pleiku khoảng 20 km đi theo tỉnh lộ 664 – Quốc lộ 14C. Không giống như những thác khác nước đổ xuống từ một vách đá chọc trời, mà thác Chín tầng trải dài qua những vách đá gồ ghề, mỗi tầng cao từ 5-10m, riêng 2 tầng cuối cùng độ cao khoảng 10-15m dựng đứng tạo nên dòng chảy mạnh, nước cuộn xoáy. Xung quanh thác là hệ sinh thái rừng còn khá nguyên sơ, góp phần tạo nên vẻ đẹp hoang dã và hùng vĩ của thác. Dòng thác hiền dịu uốn quanh những vách đá cùng với tiếng rì rào êm tai khiến đây là một điểm dã ngoại cuối tuần lý tưởng và thú vị cho du khách trong và ngoài tỉnh muốn khám phá và tìm hiểu vẻ đẹp hoang sơ, kỳ ảo của thác cũng như của núi rừng Tây Nguyên.</vn:description>
    <vn:address>Xã Ia Hrung, Ia Hrung, Gia Lai</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=1036</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_7cf4bdb09a1ecc38</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_afe957eab69b763f"/>
  </rdf:Description>
