  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_f7d173374a0c8b01">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Nhà thờ Mằng Lăng</rdfs:label>
    <vn:name>Nhà thờ Mằng Lăng</vn:name>
    <vn:description xml:lang="vi">Nhà thờ Mằng Lăng thuộc xã An Thạch, huyện Tuy An, cách trung tâm thành phố Tuy Hòa 35 km về phía Bắc. Nhà thờ Mằng Lăng được xây dựng vào năm 1892, theo lối kiến trúc gô- tích cổ điển có trang trí nhiều hoa văn, đây được xem là nhà thờ cổ nhất của tỉnh Phú Yên và là một trong những ngôi nhà thờ lâu đ ời nhất Việt Nam, đây cũng là nơi lưu giữ cuốn sách chữ Quốc ngữ đầu tiên của linh mục Alexandre de Rhodes in năm 1651 tại Roma. Trong khuôn viên nhà thờ có khu lưu niệm Á thánh An- rê Phú Yên.</vn:description>
    <vn:address>Thôn Mằng Lăng, Huyện Tuy An, Phú Yên</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=912</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_f7d173374a0c8b01</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_4ed191d353931910"/>
  </rdf:Description>
