  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_ee302839dc10e64b">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Thác Phú Cường</rdfs:label>
    <vn:name>Thác Phú Cường</vn:name>
    <vn:description xml:lang="vi">Nằm trong khu vực mỏ đá Phú Cường, thuộc địa phận xã Dun, huyện Chư Sê, tỉnh Gia Lai; cách thị trấn Chư Sê khoảng 3 km và cách TP Pleiku khoảng 45 km về phía Đông Nam. Để đến được thác Phú Cường bạn phải đi qua một hệ thống cầu thang dài kiên cố được xây bằng sắt rất chắc chắn. Bên dưới là nhiều phiến đá lớn nhỏ chồng chất lên nhau tạo nên nhiều hình thù đa đạng, lý thú.Không gian càng trở nên huyền diệu hơn, khi hòa giữa âm thanh tiếng thác nước chảy là sự pha trộn của tiếng suối và những loài chim hót trên những cây cổ thụ to lớn Vào mùa mưa, nước chảy cuồn cuộn bọt tung trắng xóa trông thật hùng vĩ. Vào mùa khô, nước suối chảy nhẹ qua những vách đá, phiến đá lớn nhỏ sẽ làm cho bạn thấy dễ chịu thoải mái, hòa mình vào thiên nhiên yên ả. Những bạn trẻ thích phiêu lưu, mạo hiểm thì có thể đi theo con đường mòn dẫn vào sâu trong lòng vách núi để có cơ hội nhìn ngắm kỹ hơn vẻ đẹp hùng vĩ , tráng lệ của ngọn thác này.</vn:description>
    <vn:address>QL25, Chư Sê, Gia Lai</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=1038</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_ee302839dc10e64b</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_afe957eab69b763f"/>
  </rdf:Description>
