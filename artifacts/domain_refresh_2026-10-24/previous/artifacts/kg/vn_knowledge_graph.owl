  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_66e109004d07f772">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Đồi chè Cầu Đất</rdfs:label>
    <vn:name>Đồi chè Cầu Đất</vn:name>
    <vn:description xml:lang="vi">Đồi chè Cầu Đất (Lâm Đồng) nằm ở độ cao 1.650m so với mực nước biển và có tuổi đời lên đến gần 100 năm. Mùa xuân đến, nơi đây trở thành điểm đến lý tưởng cho du khách khi được hòa mình vào không gian tươi mát với bầu không khí trong trẻo đượm mùi lá trà tươi. Cách trung tâm thành phố Đà Lạt khoảng chừng 23km về hướng đông nam, đồi chè Cầu Đất thuộc địa bàn thôn Cầu Đất, xã Xuân Trường nay là phường Xuân Trường Đà Lạt. Rời khỏi thành phố, thôn Cầu Đất chào đón du khách bằng những đồi chè xanh nối tiếp nhau trải dài tít tắp, những ngôi nhà nhỏ bé xinh xắn được thiết kế theo lối kiến trúc của nước Pháp, xen kẽ là vườn hoa đang đua nhau khoe sắc và vuờn hồng giòn vàng ươm mọng nước. Vào những ngày cuối đông, đầu xuân là thời điểm đồi chè đẹp nhất trong năm. Lúc này, đồi chè Cầu Đất khoác lên mình một tấm xiêm y tuyệt đẹp với màu xanh tươi của những búp chè, điểm xuyết màu vàng quyến rũ của hoa dã quỳ. Trong không gian trong trẻo và ấm áp, du khách sẽ cảm nhận được mùi lá chè dịu ngọt, tươi mới. Tại những nương chè xanh bát ngát, du khách cũng có thể chiêm ngưỡng khung cảnh đồi chè rực rỡ dưới ánh bình minh hay đầy lãng mạn dưới làn sương hoàng hôn mờ ảo. Cùng nhâm nhi một tách trà thơm nóng, hòa mình vào không gian khoáng đạt của trời và đất để cảm nhận sự bình yên, thơ mộng nhé!</vn:description>
    <vn:address>Thôn Cầu Đất, Xuân Trường - Đà Lạt, Lâm Đồng</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=1268</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_66e109004d07f772</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_b5c929c30e47fdad"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/ward_69a78bf962d21249">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Ward"/>
