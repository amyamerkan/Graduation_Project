  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_0d0ee6e5ffe9c1f3">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Thác Tầm Lu</rdfs:label>
    <vn:name>Thác Tầm Lu</vn:name>
    <vn:description xml:lang="vi">Thác Tam Lu Quảng Trị nằm ở thượng nguồn sông Long Đại. Dòng sông Long Đại bắt nguồn từ phía Tây của dãy Trường Sơn đại ngàn, có chiều dài chỉ khoảng 100 km nhưng lại có đến hơn 100 con thác lớn nhỏ. Trong số đó, Thác Tam Lu được xếp vào hàng đệ nhất về chiều cao, sự hùng vĩ và cảnh quan thiên nhiên tươi đẹp. Thác có độ cao khoảng 20 mét so với mực nước tự nhiên, đổ ào ào suốt ngày đêm xuống sông Long Đại và phân thành ba bậc thác trắng xóa tựa như ba chiếc lu đang nghiêng khiến cho dòng nước đổ xuống. Có lẽ chính vì vậy mà người dân địa phương đặt tên cho con thác này là Thác Tam Lu. Thác Tam Lu Quảng Trị vốn không còn là địa danh mới mẻ đối với du khách. Tuy nhiên, khi nhắc đến nơi để có thể hòa mình vào thiên nhiên thì thác nước này luôn luôn là một lựa chọn tuyệt vời. Bạn có thể ghé thăm Thác Tam Lu Quảng Trị vào bất cứ thời gian nào trong năm. Tuy nhiên, thời điểm lý tưởng để tham quan thác nước xinh đẹp này là vào mùa hè. Mùa hè là khoảng thời gian tuyệt vời nhất để du lịch Quảng Bình bởi tiết trời lúc này rất khô ráo, bạn sẽ không gặp phải những cơn mưa lớn cản trở chuyến hành trình của mình. Bên cạnh đó, Thác Tam Lu cũng là địa điểm hoàn hảo để bạn giải nhiệt nếu nhiệt độ ngoài trời quá oi bức vì khí hậu ở đây rất trong lành, mát mẻ.</vn:description>
    <vn:address>Trường Sơn, Trường Sơn, Quảng Trị</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=1279</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_0d0ee6e5ffe9c1f3</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_87fdcd5b2e3d3a7d"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/historicaladministrativeunit_8bd8b5dc90425c77">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#HistoricalAdministrativeUnit"/>
    <rdfs:label xml:lang="vi">Phường Song Mai</rdfs:label>
