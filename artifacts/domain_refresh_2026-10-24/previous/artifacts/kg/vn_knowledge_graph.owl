  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_07d566b425e250f5">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Biển Quy Nhơn</rdfs:label>
    <vn:name>Biển Quy Nhơn</vn:name>
    <vn:description xml:lang="vi">Bãi biển Quy Nhơn nằm ngay trung tâm thành phố Quy Nhơn, rất tiện cho bạn tham quan và tắm biển khi bạn chỉ cần đi bộ chút là ra tới bãi tắm rồi. Bãi biển Quy Nhơn rất dài, uống cong hình bán nguyệt, là bãi cát vàng với nước khá trong và xanh. Nằm ở phí Đông Nam tỉnh Bình Định, biển Quy Nhơn uốn cong theo hình cánh cung với bãi cát thoai thoải trải dài 5km từ mũi Tấn đến Ghềnh Ráng. Đặc biệt du khách đừng bỏ lỡ cơ hội khám phá Quy Nhơn về đêm, đêm về Quy Nhơn trở nên đẹp hơn, bình yên hơn, bãi biển hay những quán cà phê bên bờ biển sẽ là những nơi lý tưởng cho bạn nghỉ ngơi, thư giãn ngắm nhìn biển đêm điểm xuyến ánh đèn đánh cá ngoài khơi lấp lánh.</vn:description>
    <vn:address>Trung tâm thành phố Quy Nhơn, Thành phố Qui Nhơn, Gia Lai</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=914</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_07d566b425e250f5</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_afe957eab69b763f"/>
  </rdf:Description>
