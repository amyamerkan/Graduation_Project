  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_3f7f1a9f222ee2fa">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Nhà thờ Hải Thượng Lãn Ông</rdfs:label>
    <vn:name>Nhà thờ Hải Thượng Lãn Ông</vn:name>
    <vn:description xml:lang="vi">Nhà thờ Lê Hữu Trác được gọi là vườn đào Hải Thượng thuộc Thôn Bảo Thương, xã Sơn Quang (nay là Quang Diệm), huyện Hương Sơn - một vùng đất nằm sát bên bờ sông Ngàn Phố. Đây là chốn thâm sơn cùng cốc xưa nhưng là nơi phong cảnh hữu tình, nhân dân ở đây sống hoà thuận cùng nhau bên nếp nhà tranh. Đến nhà thờ Lê Hữu Trác - nơi có Núi Giả, Hồ Sen nằm sát nhau ở góc vườn, Hồ Sen hình bán nguyệt ôm lấy chân núi ở phía Tây Bắc. Chính nơi đây Lê Hữu Trác đã thường xuyên quan sát hướng gió để xem mạch, chữa bệnh và là chốn tri ân, nơi ông thường cùng bạn bè lên đó ngắm trăng, đón gió, uống rượu, đánh cờ, đọc sách và ngâm vịnh thơ ca.</vn:description>
    <vn:address>Thôn Bảo Thượng, Sơn Giang, Huyện Hương Sơn, Hà Tĩnh</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=991</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_3f7f1a9f222ee2fa</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_0fb5ff7d52e16a2d"/>
  </rdf:Description>
