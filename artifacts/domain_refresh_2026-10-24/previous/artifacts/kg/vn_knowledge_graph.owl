  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_83c72eb6a3a76baf">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Làng Hương Thủy Xuân</rdfs:label>
    <vn:name>Làng Hương Thủy Xuân</vn:name>
    <vn:description xml:lang="vi">Làng Hương Thủy Xuân là một làng nghề truyền thống nằm yên bình trên con đường dẫn tới Lăng Tự Đức, trở thành một điểm đến văn hóa độc đáo và là thiên đường check-in của giới trẻ. Đặc trưng lớn nhất của làng là hình ảnh hàng trăm bó hương được bó lại và xòe ra như những cánh hoa rực rỡ sắc màu, tạo nên một phông nền tuyệt đẹp cho bức ảnh đậm chất Huế. Đến đây không chỉ được chụp ảnh mà còn có cơ hội tìm hiểu về quy trình làm hương truyền thống. Bạn sẽ được chứng kiến sự tỉ mỉ của người thợ, từ khâu chọn tre, se hương đến nhuộm màu.</vn:description>
    <vn:address>84 Huyền Trân Công Chúa, Thủy Xuân, Thành phố Huế</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=1284</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_83c72eb6a3a76baf</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_3bea54f1e28e97b3"/>
  </rdf:Description>
