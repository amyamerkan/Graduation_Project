  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_f282fd70de51d60b">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Làng nghề Đúc đồng Lộng Thượng</rdfs:label>
    <vn:name>Làng nghề Đúc đồng Lộng Thượng</vn:name>
    <vn:description xml:lang="vi">Làng nghề đúc đồng Lộng Thượng, xã Đại Đồng hiện có hơn 200 hộ với hơn 800 người. Hiện nay, trong thôn thu hút trên 70 lò đúc, tạo việc làm thường xuyên cho khoảng 700 lao động với mức thu nhập bình quân 10 triệu đồng/người/tháng. Trong đó, có hơn 400 lao động là người địa phương. Ngày nay, làng đúc đồng Lộng Thượng đã được mở rộng sản xuất và phân công hóa ngành nghề, đã thành lập các cơ sở sản xuất riêng từng loại mặt hàng như: xưởng làm mâm, xưởng làm chậu, xưởng đúc đồ thờ cúng... Nhờ có sự tổ chức hoàn chỉnh, làng nhanh chóng phát triển. Các sản phẩm làm ra chủ yếu là đồ thờ cúng như: đỉnh, hạc, chân nến, đèn, mâm bổng, bát hương... được tiêu thụ trên toàn quốc. Một sản phẩm bằng đồng được làm ra là sự kết tinh tâm huyết và tài năng của người nghệ nhân. Không chỉ đòi hỏi kĩ thuật, nghề đúc đồng còn đòi hỏi sự tỉ mẩn, tinh xảo, kiên nhẫn và say mê với nghề thì mới cho ra được một sản phẩm hoàn mỹ. Lớp nghệ nhân trẻ tuổi tại làng nghề đang phát huy tinh hoa của thế hệ cha ông đi trước áp dụng phương pháp mới trong sản xuất để tạo ra sản phẩm không những giữ được dáng vẻ truyền thống, mà còn sắc sảo hơn. Từ bàn tay khéo léo của những người thợ tài hoa trong làng, những sản phẩm ấy đã góp phần tạo nét đẹp văn hóa làng quê độc đáo.</vn:description>
    <vn:address>Làng Lộng Thượng, Đại Đồng, Huyện Văn Lâm, Hưng Yên</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=729</vn:sourceUrl>
