  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_4a3c668d3bcc2e8e">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Trung tâm Thương mại Vincom Hạ Long center</rdfs:label>
    <vn:name>Trung tâm Thương mại Vincom Hạ Long center</vn:name>
    <vn:description xml:lang="vi">Thiết kế theo phong cách Hoàng gia Châu Âu sang trọng, với những hạng mục như: Trung tâm mua sắm cao cấp; chuỗi trung tâm mua sắm, tư vấn giáo dục, sức khoẻ dành riêng cho trẻ em; khu ẩm thực, sân trượt băng; khu vực chiếu phim, thế giới game… Đây là Trung tâm thương mại lớn nhất tỉnh Quảng Ninh và có tầm cỡ ở khu vực phía Bắc cho đến thời điểm này Vincom Center Hạ Long sẽ trở thành điểm nhấn tại trung tâm thành phố Hạ Long, đồng thời sẽ tạo thành một quần thể dịch vụ, một sản phẩm du lịch, điểm đến không thể bỏ lỡ khi du khách đến với Quảng Ninh</vn:description>
    <vn:address>Phường Bạch Đằng, thành phố Hạ Long, Thành phố Hạ Long, Quảng Ninh</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=1117</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_4a3c668d3bcc2e8e</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_63b239eed266f02a"/>
  </rdf:Description>
