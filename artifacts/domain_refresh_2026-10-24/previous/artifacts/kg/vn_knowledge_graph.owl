  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_67a5b60256d0346b">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">KHU LƯU NIỆM - NƠI THÀNH LẬP CHI BỘ ĐẢNG ĐẦU TIÊN CỦA SẦM SƠN</rdfs:label>
    <vn:name>KHU LƯU NIỆM - NƠI THÀNH LẬP CHI BỘ ĐẢNG ĐẦU TIÊN CỦA SẦM SƠN</vn:name>
    <vn:description xml:lang="vi">Khu lưu niệm - nơi thành lập Chi bộ Đảng đầu tiên của Sầm Sơn có giá trị và sức hấp dẫn về tài nguyên du lịch, sản phẩm du lịch khai thác chủ yếu là du lịch văn hóa Chi bộ thành lập Đảng có tên là “Chi bộ Cố Gắng” tiền thân của Đảng bộ Sầm Sơn. Chi bộ thành lập ngày 02/9/1947, tại nhà ông Vũ Đình sinh (thân sinh của đồng chí Vũ Thanh Long và Vũ Đức Linh), thôn cá Lập, xã Quảng Tiến, huyện Quảng Xương, nay là khu phố Trung Chính, phường Quảng Cư, thành phố Sầm Sơn. Chi bộ gồm 6 Đảng viên, do đồng chi Trần Huệ Như làm Bí thư. Chi bộ Đảng đầu tiên ra đời là sự kiện chính trị quan trọng của nhân dân Sầm Sơn, từ đây, nhân dân Sầm Sơn dưới sự lãnh đạo trực tiếp của Tổ chức Đảng, vượt qua khó khăn, thách thức, đạt được nhiều thành tựu trong sự nghiệp kháng chiên, kiến quốc, xây dựng, bảo vệ quê hương, đất nước. Khu lưu niệm - nơi thành lập Chi bộ Đảng đầu tiên của Sầm Sơn là nơi lưu giữ lại tiền thân của Đảng bộ Sầm Sơn, những hiện vật, tranh ảnh của Chi bộ Đảng, một sự kiện chính trị quan trọng của nhân dân Sầm Sơn.</vn:description>
    <vn:address>phường Quảng Cư, thành phố Sầm Sơn, tỉnh Thanh Hóa (nay là phường Sầm Sơn, tỉnh Thanh Hoá), Sầm Sơn, Thanh Hoá</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=1253</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_67a5b60256d0346b</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_3d86d1f4989b8999"/>
  </rdf:Description>
