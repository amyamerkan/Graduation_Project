  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_6b58d0b16441166a">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Hòn Một</rdfs:label>
    <vn:name>Hòn Một</vn:name>
    <vn:description xml:lang="vi">Giữa không khí tấp nập và sôi động trên đảo ngọc Phú Quốc, Hòn Một lại mang vẻ đẹp hoang sơ, thanh bình tựa như thiên đường cổ tích. Nằm về phía Đông Bắc của đảo ngọc, gần bãi Thơm nổi tiếng, Hòn Một phù hợp với du khách yêu thích du lịch khám phá và gần gũi với thiên nhiên. Nơi đây cách đảo Phú Quốc chỉ 200m, vì vậy người dân địa phương đã dựng một cây cầu gỗ nhỏ để ra Hòn Một vào những ngày mùa mưa. Còn vào mùa khô, khi nước biển cạn, du khách có thể trải nghiệm đi bộ trên con đường nổi giữa biển để cảm nhận sự bao la của biển cả cũng như không khí trong lành, dịu mát nơi đây. Cùng thuộc hệ sinh thái đảo ngọc, nên Hòn Một sở hữu làn nước biển xanh ngọc trong vắt và hệ thực vật phong phú với những tán cây xanh cổ thụ có hình thù đẹp mắt. Tất cả tạo nên một khung cảnh tựa như chốn cổ tích, hấp dẫn bất kỳ du khách nào. Vì đảo nhỏ nên tại Hòn Một chỉ có một con đường nhựa, men theo lối đi là những túp lều xinh xắn dành cho du khách nghỉ ngơi và tổ chức các hoạt động như chụp ảnh, cắm trại, nướng BBQ… Điểm đặc biệt ở hệ sinh thái Hòn Một là sự phát triển mạnh mẽ của rau muống biển với những cánh hoa tím mỏng manh, vừa thơ mộng, vừa lạ mắt. Các hoạt động du lịch tại đây còn hoang sơ và mới mẻ, vì vậy với những du khách có kế hoạch khám phá Hòn Một, hãy chuẩn bị đầy đủ dụng cụ, thức uống và gìn giữ môi trường du lịch xanh, sạch, đẹp.</vn:description>
    <vn:address>Tọa lạc ở phía đông bắc của đảo Ngọc Phú Quốc, Thành phố Phú Quốc, An Giang</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=697</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_6b58d0b16441166a</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_84c51f66e615508d"/>
  </rdf:Description>
