  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_245e5d1c5aac3395">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Chùa Phước Kiển (Chùa Lá Sen)</rdfs:label>
    <vn:name>Chùa Phước Kiển (Chùa Lá Sen)</vn:name>
    <vn:description xml:lang="vi">Chùa Phước Kiển hay còn gọi là chùa Lá Sen, được xây dựng với nền kiến trúc độc đáo mang đậm dấu ấn Phật Giáo. Điểm nhấn nổi bật nhất của chùa chính là những lá sen khổng lồ với đường kính tư 1,5m đến 2n, dày, gân lá to, mép cao đến 4-5 cm giống như một cái nia trông lạ mắt. Đặc biệt, lá sen này có thể chịu được sức nặng của một người lớn 70kg, nếu không được tận mắt nhìn thấy, chắc có người sẽ hoài nghi rằng dưới lá sen khổng lồ kia chắc có khung thép Đến đây, du khách sẽ có khoảng thời gian tĩnh tâm, thư giãn trong không gian yên tĩnh và không khí trong lành của chùa và thắp nén nhang xin mọi điều an lành cho gia đình, người thân</vn:description>
    <vn:address>, Huyện Châu Thành</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=1043</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_245e5d1c5aac3395</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_a838751ae0fec8ea"/>
  </rdf:Description>
