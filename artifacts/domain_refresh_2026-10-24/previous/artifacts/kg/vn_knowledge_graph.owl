  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_73e285764538f5c9">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Hội Quán Phước Kiến</rdfs:label>
    <vn:name>Hội Quán Phước Kiến</vn:name>
    <vn:description xml:lang="vi">Hội quán Phước Kiến là địa điểm du lịch Hội An thu hút nhiều bạn trẻ tới check-in bởi nét kiến trúc Trung Hoa cổ kính, diễm lệ mang đến background cực xịn cho những bức ảnh ‘’so deep’’. Hội quán được xây dựng vào thế kỷ 17 bởi cộng đồng người Hoa Phước Kiến sinh sống tại Hội An. Nơi đây từng là trung tâm sinh hoạt cộng đồng, nơi thờ cúng tín ngưỡng và tổ chức các hoạt động văn hóa, thương mại của người Hoa Phước Kiến.</vn:description>
    <vn:address>46 Trần Phú, Hội An, Thành phố Đà Nẵng</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=1286</vn:sourceUrl>
