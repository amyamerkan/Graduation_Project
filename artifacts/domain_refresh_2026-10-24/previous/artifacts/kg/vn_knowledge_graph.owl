  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_c1a1434dda0ac1ca">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Quần đảo Cát Bà</rdfs:label>
    <vn:name>Quần đảo Cát Bà</vn:name>
    <vn:description xml:lang="vi">Nằm cách trung tâm thành phố chừng 60km, quần đảo Cát Bà là một địa chỉ ở Hải Phòng được nhiều người quan tâm. Quần đảo này nằm liền kề với vịnh Hạ Long, ngoài khơi thành phố Hải Phòng. Ngoài du lịch biển đảo, Cát Bà còn là nơi duy nhất ở Việt Nam hội tụ ba danh hiệu quốc gia và quốc tế gồm vườn Quốc gia Cát Bà, khu bảo tồn biển và khu dự trữ sinh quyển thế giới. Ngày nay, đảo Cát Bà đã phát triển mạnh mẽ về du lịch nhờ sở hữu cảnh quan đẹp. Nơi đây có hàng trăm hòn đảo lớn nhỏ, có rất nhiều bãi biển thiên nhiên quyến rũ và có rừng nguyên sinh với nhiều động thực vật quý hiếm. Đến với Cát Bà, bạn sẽ được đắm chìm trong vẻ đẹp hoang sơ mà quyến rũ của biển xanh, cát trắng nắng vàng, thưởng thức bức tranh biển trời hài hòa đến từng chi tiết cách phối màu của tạo hóa. Và một điều bạn nhất định được quên chính là nếm thử những món ăn hải sản tươi ngon, giàu dinh dưỡng của biển cả nơi đây nhé! Các địa điểm và hoạt động vui chơi tại đảo Cát Bà: Tắm biển và chơi các trò chơi trên biển Thăm đảo Khỉ Chèo thuyền Kayak Làng chài cổ Cái Bèo Vườn quốc gia Cát Bà Pháo đài thần công Cát Bà Nhìn chung quần đảo Cát Bà khá lớn nên hầu hết du khách khi đến nơi đây đều muốn quay lại để được khám phá thêm thật nhiều thứ nữa đấy. Vì hòn đảo này nằm khá xa đất liền nên để có một chuyến đi trọn vẹn bạn nên đi theo tour hoặc cùng người có kinh nghiệm hướng dẫn nhé!</vn:description>
    <vn:address>được phân bố trên địa bàn 6 xã: Gia Luận, Việt Hải, Trân Châu, Xuân Đám, Phù Long, Hiền Hào và thị trấn Cát Bà, Huyện Cát Hải, Thành phố Hải Phòng</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=636</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_c1a1434dda0ac1ca</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_c1206ae1209e8075"/>
  </rdf:Description>
