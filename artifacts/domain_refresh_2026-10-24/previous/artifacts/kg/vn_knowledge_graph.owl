  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_2f07232bedcf0589">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Khu du lịch sinh thái Gáo Giồng</rdfs:label>
    <vn:name>Khu du lịch sinh thái Gáo Giồng</vn:name>
    <vn:description xml:lang="vi">Khu du lịch sinh thái Gáo Giồng thuộc xã Gáo Giồng, huyện Cao Lãnh, là vùng đất điển hình của hệ sinh thái Đồng Tháp Mười, nước và đất bị nhiễm phèn nặng. Bằng sức lao động của con người, Gáo Giồng đã trở thành rừng phòng hộ – là lá phổi xanh của vùng Đồng Tháp Mười, tạo đất sống của nhiều loài chim, cá và thực vật sinh sôi, nảy nở, với diện tích 1.670ha, trong đó có 250ha rừng nguyên sinh với những bưng, trấp, lau sậy, sen, súng, cà na, gáo,… và sân chim hơn 36ha, đa dạng về chủng loại và đặc biệt là loài nhan điển quý hiếm được đưa vào sách đỏ. Đến đây, du khách sẽ ngợp mắt trước sân chim rộng hơn 36ha cùng nhiều loài chim bay rợp cả một góc trời. Trên những vạt rừng rộng mênh mông, hàng chục loài chim nước sinh sống và làm tổ quanh năm như: Trích mồng đỏ, Cồng Cộc, Le Le, Diệc, Vịt trời,… Nhiều hơn hết vẫn là cò trắng với hàng chục nghìn con khiến rừng tràm này được xem là vườn cò lớn nhất hiện nay ở vùng Đồng Tháp Mười. Vào mùa nước nổi,trên các cánh đồng hàng nghìn cánh cò trắng bay lượn trên nến tràm xanh tươi tạo thành một khung cảnh ngoạn mục. Còn các lung sen lại là nơi quy tụ hàng nghìn con Trích mồng đỏ về đây thư thả nhổ những cọng năng tươi non. Thỉnh thoảng cất tiếng gáy kèm theo những vũ điệu tuyệt đẹp. Đến với Gáo Giồng, không những nghe chim hót trên cây du khách còn nghe tiếng cá quẫy đuôi mời chào dưới nước như những câu thơ: “Xin mời ghé chốn quê tôi cứ này Quê tôi vừa đẹp vừa hay Dưới sông cá lội, trên trời chim bay”… Du khách đến với Gáo Giồng sẽ cảm nhận được thanh bình và thích thú khi lênh đênh trên xuồng ba lá đi qua các kênh rạch, chạy xe đạp trong rừng tràm, nghỉ mát tại chòi lá của người dân và thưởng thức các món đặc sản miền Tây mùa nước nổi vô cùng độc đáo như: rắn nướng mọi, rau mát, bông súng…</vn:description>
    <vn:address>Ấp 6, Huyện Cao Lãnh</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=1042</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_2f07232bedcf0589</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_a838751ae0fec8ea"/>
  </rdf:Description>
