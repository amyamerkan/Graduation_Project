  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_2e5f3aaf0d002079">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Núi Thiên Ấn</rdfs:label>
    <vn:name>Núi Thiên Ấn</vn:name>
    <vn:description xml:lang="vi">Ngọn núi nổi tiếng với khung cảnh hùng vĩ cùng giá trị lịch sử mà nó mang trong mình. Núi Thiên Ấn nằm ở lưu vực sông Tràng Khúc và cách trung tâm Quảng Ngãi khoảng 4km đi về hướng đông. Từ xa nhìn lại chúng ta đã có thể chiêm ngưỡng dáng vẻ độc đáo của núi hòa với rừng cây xanh trùng điệp.</vn:description>
    <vn:address>Sơn Tịnh, Sơn Tịnh, Quảng Ngãi</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=1275</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_2e5f3aaf0d002079</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_8999671be65a3fdb"/>
  </rdf:Description>
