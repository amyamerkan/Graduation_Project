  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_53c22efaa96e7a99">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Thác Chapơr</rdfs:label>
    <vn:name>Thác Chapơr</vn:name>
    <vn:description xml:lang="vi">Thác Chapơr được ví như một nàng tiên có mái tóc dài óng ả, đẹp đến mê hồn, bởi bên cạnh vẻ đẹp của dòng thác từ trên cao đổ xuống là sự hài hòa của thiên nhiên với rừng trúc và rừng bằng lăng bạt ngàn. Thác Chapơr thuộc thôn Ma Lâm, xã Phước Tân, huyện Bác Ái, tỉnh Ninh Thuận cũ, nay là xã Bác Ái Tây, tỉnh Khánh Hòa. Ngọn thác cao 50m đổ từ trên cao xuống như dải lụa vắt ngang giữa đại ngàn. Nằm cách trung tâm thành phố Phan Rang - Tháp Chàm khoảng 70km. Hiện tại để vào được thác thì du khách phải gửi xe bìa rừng, sau đó đi bộ khoảng 30 phút sẽ đến được thác. Đổi lại công sức sẽ đền đáp bằng cảnh thác nước hùng vĩ, hoang sơ giữa núi rừng. Bên cạnh các dòng thác còn có những tảng đá lớn, là nơi để du khách nghỉ ngơi, ngắm nhìn cảnh vật miền núi hoang sơ và kỳ bí. Ngoài ra, tham quan thác Chapơr, du khách còn được nghe những làn điệu sử thi âm vang hay cả tiếng đàn Chapi huyền thoại cùng tiếng thì thào của núi rừng Bác Ái. Với vẻ đẹp hùng vĩ được thiên nhiên ban tặng, thác Chapơr đã và đang là một địa điểm phát triển du lịch sinh thái gắn với bản sắc văn hóa của đồng bào dân tộc Raglai được tôn tạo và bảo vệ. Nơi đây là điểm đến hứa hẹn sẽ làm hài lòng mọi du khách đến tham quan. Nếu có thời gian, du khách nên ở lại qua đêm tại nhà người dân ở gần thác để có thể được thưởng thức những món ăn ngon đặc trưng của vùng miền này. Du khách sẽ được hòa mình vào cuộc sống sinh hoạt thường ngày cũng như được lắng nghe những câu chuyện ly kỳ gắn liền với ngọn thác Chapơr. Hoặc đơn giản là thư giãn lắng nghe âm thanh của núi non, thác nước và tưởng tượng tiếng hát của Chapơr. Đó chắc chắn sẽ là một trong những trải nghiệm thú vị nhất trong hành trình khám phá du lịch.</vn:description>
    <vn:address>Thôn Ma Lâm, Bác Ái Tây, Khánh Hoà</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=1267</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_53c22efaa96e7a99</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_b568d1fc7077e7e2"/>
  </rdf:Description>
