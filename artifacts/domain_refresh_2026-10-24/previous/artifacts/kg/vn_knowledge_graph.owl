    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_64296730a3452ffd"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/historicaladministrativeunit_2c14988f59abd9a8">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#HistoricalAdministrativeUnit"/>
