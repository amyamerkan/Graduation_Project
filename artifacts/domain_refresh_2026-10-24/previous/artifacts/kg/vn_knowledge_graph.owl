    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Trại ngựa Bá Vân</rdfs:label>
    <vn:name>Trại ngựa Bá Vân</vn:name>
    <vn:description xml:lang="vi">Thái Nguyên vốn nổi tiếng với những nương chè bát ngát hay hồ Núi Cốc tuyệt đẹp gắn liền với câu chuyện tình yêu của đôi trai gái. Nếu muốn tìm một trải nghiệm mới ở "đất chè" thì hiện tại đến Thái Nguyên, bạn còn có thể tìm đến một địa điểm mới: trại ngựa Bá Vân. Trại ngựa Bá Vân thuộc xã Bình Sơn, thành phố Sông Công, tỉnh Thái Nguyên. Thông thường, mỗi ngày trại chỉ thả ngựa vài giờ (khoảng từ 10h – 15h). Đây được coi là thời điểm đẹp nhất của trại ngựa Bá Vân. Do đó, nếu có thể, bạn nên ghé thăm trại ngựa vào khoảng thời gian này. Từng đàn ngựa tung tăng gặm cỏ, thỏa sức chạy nhảy, trại ngựa Bá Vân vào lúc ấy tựa như một thảo nguyên thu nhỏ. Chẳng cần đến Mông Cổ, bạn vẫn có thể tận mắt chiêm ngưỡng sự dũng mãnh của “vó ngựa thảo nguyên". Khung cảnh những con ngựa nhởn nhơ xung quanh bãi đồi và hồ nước tạo thành một khung cảnh tuyệt đẹp. Trại ngựa Bá Vân là nơi nghiên cứu, bảo tồn, nhân giống và lai tạo rất nhiều giống ngựa. Trong đó, ngựa đua và ngựa bạch được coi là những loại quý nhất. Đến thăm trại Bá Vân, bạn sẽ được ngắm nhìn rất nhiều loài ngựa với những đặc điểm khác nhau. Đây chắc chắn sẽ là trải nghiệm vô cùng thú vị dành cho bạn khi đến khám phá mảnh đất Thái Nguyên. Trại ngựa Bá Vân là địa điểm tham quan mới, du khách đến đây có thể đi tham quan, tìm hiểu về các giống ngựa, cho ngựa ăn, check-in với khung cảnh mênh mông, thơ mộng của nơi này</vn:description>
    <vn:address>, Thành phố Sông Công, Thái Nguyên</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=1031</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_915b1c201faf1620</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_43c0ce9394be65ad"/>
  </rdf:Description>
