  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_c838b3a921661050">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Khu Du lịch cấp quốc gia Trà Cổ Móng Cái</rdfs:label>
    <vn:name>Khu Du lịch cấp quốc gia Trà Cổ Móng Cái</vn:name>
    <vn:description xml:lang="vi">Là nơi " đặt nét bút đầu tiên để vẽ hình chữ S bản đồ tổ quốc Việt Nam". Cách trung tâm thị xã Móng Cái 07 km, bờ biển Trà Cổ uốn vành hình khuyên trải dài 17 Km từ mũi Gót ở phía bắc đến mũi Ngọc ở phía nam, được mệnh danh là " Bãi biển trữ tình nhất Việt Nam" với bãi cát trắng mịn, phẳng và rộng hoà trong làn nước xanh biếc in bóng hàng dương xanh. Do cách xa các trung tâm công nghiệp lớn nên Trà Cổ có khí hậu mát mẻ, nồng nàn hương biển và không gian yên tĩnh hoang sơ.. Nhiệt độ trung bình hàng năm ở Trà cổ khoảng 220 C, đặc biệt rất lý tưởng vào mùa hè Trà cổ còn hấp dẫn hơn với những ai thích khám phá văn hoá, lịch sử, ngoài những cảnh đẹp tự nhiên như Cồn mang, Sa vĩ.. Trà Cổ còn có nhiều di tích lịch sử nghệ thuật văn hoá được xếp hạng như: Đình Trà Cổ , Chùa Nam Thọ , Chùa Xuân Lan , Nhà Thờ xứ Trà Cổ</vn:description>
    <vn:address>Phường Trà Cổ, tp Móng Cái, Thành phố Móng Cái, Quảng Ninh</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/area/?item=22</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_c838b3a921661050</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_63b239eed266f02a"/>
  </rdf:Description>
