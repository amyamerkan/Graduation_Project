  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_b49baa27822eb3cc">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Khu du lịch Lan Vương</rdfs:label>
    <vn:name>Khu du lịch Lan Vương</vn:name>
    <vn:description xml:lang="vi">Chỉ cách trung tâm thành phố Bến Tre khoảng 5km, khu du lịch Lan Vương là một trong những địa điểm nghỉ dưỡng, vui chơi lý tưởng được nhiều người lựa chọn. Du khách khi tới đây vừa có thể hòa mình vào không gian thiên nhiên xanh mát lại vừa có cơ hội trải nghiệm những trò chơi vui nhộn như: cầu lắc, đu dây, chạy xe đạp qua cầu khỉ,... Ngoài những trò chơi thú vị, khu du lịch Lan Vương còn kết hợp nhiều dịch vụ du lịch để phục vụ du khách khác như: khu vực nhà hàng, farmstay nghỉ ngơi, cắm trại,.... Nếu bạn muốn tìm kiếm một địa điểm du lịch Bến Tre để vui chơi cùng gia đình và bạn bè thì khu du lịch Lan Vương sẽ là một lựa chọn tuyệt vời đấy.</vn:description>
    <vn:address>tỉnh lộ 887 thuộc Ấp 2, Thành phố Bến Tre, Bến Tre</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=1078</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_b49baa27822eb3cc</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_c5f44df60fc7e6f5"/>
  </rdf:Description>
