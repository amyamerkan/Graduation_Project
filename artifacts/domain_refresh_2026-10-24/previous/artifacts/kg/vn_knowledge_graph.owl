  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_a636419c6f2cd553">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Làng nhà sàn Thái Hải</rdfs:label>
    <vn:name>Làng nhà sàn Thái Hải</vn:name>
    <vn:description xml:lang="vi">Làng nhà sàn Thái Hải thuộc xóm Mỹ Hào, xã Thịnh Đức, TP. Thái Nguyên. Đây là 1 ốc đảo nằm giữa 2 thành phố lớn của Thái Nguyên, chỉ cách trung tâm TP. Thái Nguyên và trung tâm TP. Sông Công khoảng 10km, cách Trại Ngựa Bá Vân 3km. Làng nhà sàn Thái Hải có tên gọi đầy đủ là Khu bảo tồn làng nhà sàn dân tộc sinh thái Thái Hải, với diện tích khoảng 25ha đây là nơi quy tụ và gìn giữ của hơn 30 ngôi nhà sàn có tuổi đời ngót nghét trăm năm, Các ngôi nhà sàn này đều được chuyển từ khu ATK Định Hóa Thái Nguyên và được phục dựng nguyên bản lại với mục đích gìn giữ và bảo tồn. Với khung cảnh 4 bề là đồi cây ở giữa là hồ nước, rải rác xung quanh là những ngôi nhà sàn. Tại đây có bà con dân tộc Tày và Nùng sinh sống giống như là 1 bản làng. Trong Làng nhà sàn sẽ được chia làm nhiều khu vực, gồm: Khu bảo tồn, khu ẩm thực, khu nghỉ dưỡng, khu vui chơi giải trí, tổ chức sự kiện… Điều ấn tượng nhất khi đến đây là được thưởng thức cũng như là tìm hiểu và văn hóa hát Then. Hát Then là 1 nét văn hóa đặc trưng của bà con dân tộc Tày.</vn:description>
    <vn:address>Xóm Mỹ Hào, Thành phố Thái Nguyên, Thái Nguyên</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=1032</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_a636419c6f2cd553</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_43c0ce9394be65ad"/>
  </rdf:Description>
