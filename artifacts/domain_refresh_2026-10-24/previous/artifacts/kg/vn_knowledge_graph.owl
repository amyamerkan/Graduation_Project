  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_087c6ab0943580de">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Nhà cổ Phùng Hưng</rdfs:label>
    <vn:name>Nhà cổ Phùng Hưng</vn:name>
    <vn:description xml:lang="vi">Địa điểm du lịch Hội An này đã hơn 100 năm tuổi. Đây là một trong những ngôi nhà cổ lâu đời nhất ở Hội An. Bước vào nhà cổ Phùng Hưng, bạn sẽ được chiêm ngưỡng kiến trúc với sự kết hợp hài hòa của Nhật Bản - Trung Hoa - Việt Nam tại phố cổ Hội An. Nhà cổ Phùng Hưng đã trải qua 8 đời con cháu sinh sống. Mỗi người con sống trong ngôi nhà đều luôn mang trong mình ý thức giữ gìn và bảo quản cho ngôi nhà thật tốt. Nếu may mắn, bạn sẽ được chủ nhà giới thiệu về từng kiến trúc, nét đặc sắc trong căn nhà. Tầng trệt là nơi tiếp khách của gia chủ. Đồng thời, tầng trệt cũng là nơi lưu giữ rất nhiều cổ vật quý giá, sang trọng qua từng năm tháng. Tầng thứ 2 của nhà cổ Phùng Hưng là nơi đặt bàn thờ tổ tiên và bà Thiên Hậu Thánh Mẫu. Trước bàn thờ, chủ nhà đặt bẫy quân xúc xắc để xin ý trước khi làm việc lớn.</vn:description>
    <vn:address>4 Nguyễn Thị Minh Khai, Hội An, Thành phố Đà Nẵng</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=1287</vn:sourceUrl>
