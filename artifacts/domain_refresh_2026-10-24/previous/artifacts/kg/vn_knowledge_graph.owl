  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_b25e423063b3a1d4">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Bãi biển Hoành Sơn</rdfs:label>
    <vn:name>Bãi biển Hoành Sơn</vn:name>
    <vn:description xml:lang="vi">Nằm ngay dưới chân đèo Ngang, biển Hoành Sơn gây ấn tượng bởi vẻ đẹp nguyên sơ, tĩnh lặng với làn nước trong xanh, bãi cát sạch mịn và những vách đá dựng đứng. Nhờ cách xa khu dân cư đông đúc, nơi đây vẫn giữ được không gian thoáng đãng, yên bình, thích hợp cho những ai muốn tìm về với thiên nhiên. Không ồn ào hay phô trương, Hoành Sơn cuốn hút du khách bằng vẻ đẹp giản dị. Làn nước trong xanh, bờ cát mịn trải dài cùng những con sóng nhẹ tạo nên nhịp điệu êm đềm, khiến lòng người như chậm lại. Trong ánh nắng đầu ngày, mặt biển lấp lánh như một tấm gương khổng lồ phản chiếu bầu trời, mở ra không gian vừa khoáng đạt vừa bình yên. Không gian tại biển Hoành Sơn không quá đông đúc, du khách có thể dễ dàng tìm cho mình một góc riêng để tận hưởng trọn vẹn vẻ đẹp của biển. Một buổi dạo bước trên bãi cát, lắng nghe tiếng sóng rì rào hay ngâm mình trong làn nước mát lành cũng đủ giúp xua tan những mệt mỏi sau những ngày bận rộn. Đặc biệt, vào những ngày đầu mùa, khi nắng chưa quá gay gắt, biển Hoành Sơn càng trở nên dịu dàng và dễ chịu. Không khí trong lành, biển xanh và nhịp sống chậm rãi tạo nên điều kiện lý tưởng để du khách thư giãn, nghỉ ngơi và tận hưởng những khoảnh khắc gần gũi với thiên nhiên. Không cầu kỳ, không phô trương, biển Hoành Sơn chinh phục du khách bằng chính vẻ đẹp mộc mạc và sự bình yên vốn có . Với những ai đang tìm kiếm một không gian để nghỉ ngơi, thư giãn và hòa mình vào thiên nhiên, Hoành Sơn là điểm đến đáng để khám phá và trải nghiệm.</vn:description>
    <vn:address>cách chân đèo Ngang chưa tới 2km theo hướng Bắc - Nam, Hoành Sơn, Hà Tĩnh</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=1263</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_b25e423063b3a1d4</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_0fb5ff7d52e16a2d"/>
  </rdf:Description>
