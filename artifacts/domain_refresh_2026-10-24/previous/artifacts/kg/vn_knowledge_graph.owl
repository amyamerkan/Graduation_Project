  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_490731a382b43104">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Hồ Hoàn Kiếm</rdfs:label>
    <vn:name>Hồ Hoàn Kiếm</vn:name>
    <vn:description xml:lang="vi">Hồ Hoàn Kiếm, hay còn gọi là Hồ Gươm được mệnh danh là viên ngọc sáng của Thủ đô Hà Nội. Nơi đây đã trở thành điểm đến nổi tiếng thu hút du khách, gắn liền với đời sống văn hóa của người dân Hà Thành bao đời nay. Hồ Gươm còn có một số tên gọi khác như hồ Tả Vọng, hồ Lục Thủy (hồ nước xanh) hay hồ Thủy Quân (bởi hồ từng là nơi để huấn luyện thủy binh chiến đấu). Đến thế kỉ XV, hồ được đổi tên thành hồ Hoàn Kiếm (trả gươm), gắn liền với sự tích trả gươm báu cho rùa vàng của vua Lê Thái Tổ. Từ đó đến nay, hồ Hoàn Kiếm được bảo tồn trở thành di tích lịch sử văn hóa có ý nghĩa quan trọng của thủ đô nói riêng và cả nước nói chung. Hồ Gươm là nơi tụ hội lý tưởng bốn mùa: rực rỡ trong sắc đào và các lễ hội truyền thống vào mùa xuân, khi đón những cơn gió mát xua tan oi bức của mùa hè, say đắm trong khung cảnh thơ mộng bên hàng liễu rủ của mùa thu hay vẻ đẹp mơ màng trong không khí lạnh giá khi mùa đông về. Nằm trên gò đất trung tâm hồ, Tháp Rùa là điểm nhấn thu hút nhất ở Hồ Gươm. Được xây dựng từ những năm 1884, với lối kiến trúc Pháp kết hợp với kiến trúc phong kiến cổ xưa của Việt Nam, Tháp Rùa nổi lên giữa hồ cổ kính, rêu phong và đầy trầm mặc. Xung quanh hồ còn nhiều di tích nổi tiếng như Tháp Hòa Phong, Tháp Bút, Cầu Thê Húc, Đền Ngọc Sơn, Đền Bà Kiệu… Để tham quan hồ Gươm, du khách có thể lựa chọn nhiều phương tiện di chuyển như xe máy, xích lô, xe điện hoặc đi bộ để khám phá và cảm nhận rõ hơn cảnh sắc tươi đẹp xung quanh hồ. Những năm gần đây, vào các ngày cuối tuần, xung quanh hồ sẽ trở thành phố đi bộ với nhiều hoạt động hấp dẫn như âm nhạc đường phố, các trò chơi dân gian…. thu hút đông đảo du khách. Dạo chơi tại phố đi bộ và dành thời gian thưởng thức các món ẩm thực nổi tiếng ở trung tâm phố cổ sẽ là trải nghiệm đáng nhớ của du khách khi tới Hà Nội.</vn:description>
    <vn:address>Hồ Hoàn Kiếm còn được gọi là Hồ Gươm là một hồ nước ngọt tự nhiên, Hoàn Kiếm, Quận Hoàn Kiếm, Thành phố Hà Nội</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=53</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_490731a382b43104</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_49007d4c7b40821e"/>
  </rdf:Description>
