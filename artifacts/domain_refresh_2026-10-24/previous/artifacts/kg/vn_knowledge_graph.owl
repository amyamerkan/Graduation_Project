  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_ce87b9a0b6fd0ad7">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Mũi Đá Vách</rdfs:label>
    <vn:name>Mũi Đá Vách</vn:name>
    <vn:description xml:lang="vi">Mũi Đá Vách, tọa lạc tại xã Vĩnh Hải, tỉnh Khánh Hòa, là một kiệt tác thiên nhiên hoang sơ và hùng vĩ, thu hút du khách bởi những vách đá dựng đứng cao từ 20–30m trải dài gần 500m dọc bờ biển. Được hình thành qua hàng triệu năm biến động địa chất, các vách đá tại đây mang nhiều tầng lớp đá khác nhau, từ đá vôi, đá granite đến đá trầm tích, tạo nên những hình thù độc đáo như những bức tranh điêu khắc tinh tế của thiên nhiên. Để đến Mũi Đá Vách, du khách có thể lựa chọn đi thuyền từ vịnh Vĩnh Hy hoặc trekking từ làng chài phía bắc vịnh. Hành trình này không chỉ mang lại cảm giác phiêu lưu mà còn mở ra cơ hội chiêm ngưỡng vẻ đẹp hoang sơ của vùng biển Khánh Hòa Mũi Đá Vách còn là điểm đến lý tưởng cho những ai yêu thích hoạt động ngoài trời như cắm trại, leo núi và lặn biển. Với hệ sinh thái biển phong phú, du khách có thể lặn ngắm những rặng san hô nhiều màu sắc và các loài sinh vật biển đa dạng. Buổi chiều, ngồi trên bãi biển ngắm hoàng hôn buông xuống, nhuộm đỏ cả bầu trời và mặt biển, sẽ mang lại cảm giác bình yên và thư giãn khó quên. Nếu bạn đang tìm kiếm một điểm đến để hòa mình vào thiên nhiên và trải nghiệm những khoảnh khắc yên bình, Mũi Đá Vách chắc chắn sẽ là lựa chọn không thể bỏ qua trong hành trình khám phá Khánh Hòa.</vn:description>
    <vn:address>Nằm trong Vịnh Vĩnh Hy, Vĩnh Hải, Khánh Hoà</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=1266</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_ce87b9a0b6fd0ad7</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_b568d1fc7077e7e2"/>
  </rdf:Description>
