  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_0a892c6e83066288">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Trung tâm Mỹ Ngọc - Công ty CP Ngọc trai Hạ Long</rdfs:label>
    <vn:name>Trung tâm Mỹ Ngọc - Công ty CP Ngọc trai Hạ Long</vn:name>
    <vn:description xml:lang="vi">Là nơi trưng bày giới thiệu và bán sản phẩm trang sức Ngọc Trai và đồ lưu niệm bằng vỏ trai của Công ty được trực tiếp nuôi cấy trên vịnh Hạ Long, với quy trình khép kín từ khâu sinh sản, con giống, nuôi cấy ngọc trai bằng công nghệ Nhật Bản. Sản phẩm của trung tâm đa dạng phong phú, nhiều chủng loại, mẫu mã, hợp thời trang, hấp dẫn du khách. Hiện nay trung tâm Mỹ Ngọc đã thu hút được nhiều tuor du lịch. Đối tượng khách chủ yếu là khách Âu, lưu lượng trung bình 1000 khách/ngày. Có phong cảnh đẹp hướng ra vịnh Hạ Long, hệ thống cây xanh, vui chơi thư giãn cho du khách: Câu cá, ngắm hồ, chụp ảnh thôn quê…</vn:description>
    <vn:address>Phường Hà Khẩu, thành phố Hạ Long, Thành phố Hạ Long, Quảng Ninh</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=1119</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_0a892c6e83066288</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_63b239eed266f02a"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/ward_ccf7e06504cec55c">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Ward"/>
    <rdfs:label xml:lang="vi">Xã Cô Tô</rdfs:label>
