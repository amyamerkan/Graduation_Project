  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_089a72ca35d29215">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Thác Gió</rdfs:label>
    <vn:name>Thác Gió</vn:name>
    <vn:description xml:lang="vi">Ẩn mình trong ngọn núi cao lên đến 300m, Thác Gió - Vườn thực vật thuộc huyện Bố Trạch nổi tiếng với phong cảnh thiên nhiên hoang sơ, hùng vĩ. Nơi đây trở thành điểm du lịch lý tưởng tại Quảng Bình, đặc biệt là vào những ngày hè. Thác Gió là điểm tham quan nổi bật nhất khi đến với Vườn thực vật. Khung cảnh ở đây được ví như một bức tranh thuỷ mặc với dòng thác trắng xóa vắt ngang những vách đá sừng sững và dòng nước trong vắt chảy qua từng phiến đá. Với những du khách ưa mạo hiểm, từ Thác Gió có thể chinh phục những cung đường gập ghềnh, tiến sâu vào rừng hay thử sức với hoạt động đu dây. Từ độ cao của Thác Gió, bạn có thể phóng tầm mắt chiêm ngưỡng sự kỳ vĩ của thiên nhiên Phong Nha - Kẻ Bàng. Đến với Thác Gió - Vườn thực vật, bạn sẽ phải trầm trồ trước sự đa dạng của thiên nhiên với mẫu vật của hàng trăm loài động thực vật quý hiếm tại Nhà trưng bày mẫu vật. Đi dạo trên con đường mòn xuyên rừng rợp bóng cây xanh mát, du khách sẽ đến với hồ Vàng Anh - hồ nước trong vắt giữa lòng cánh rừng nguyên sinh với vẻ đẹp trong xanh như ngọc. Tại đây, bạn có thể nghỉ ngơi bên lều trại hay thỏa sức chụp ảnh bên hồ để lưu giữ cho mình những khoảnh khắc thật đẹp giữa thiên nhiên hùng vĩ. Vào những ngày hè thời tiết nóng bức, được đắm mình trong dòng suối mát lạnh, lắng nghe tiếng nước chảy thác vang động và ngắm nhìn thiên nhiên hùng vĩ chắc chắn sẽ là phương pháp giải nhiệt tuyệt vời.</vn:description>
    <vn:address>Đường 20 Quyết Thắng, Bố Trạch, Quảng Trị</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=1277</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_089a72ca35d29215</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_87fdcd5b2e3d3a7d"/>
  </rdf:Description>
