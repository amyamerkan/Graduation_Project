  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_37a1bb1b5038ef4f">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Hòn Gầm Ghì</rdfs:label>
    <vn:name>Hòn Gầm Ghì</vn:name>
    <vn:description xml:lang="vi">Hòn Gầm Ghì (Phú Quốc) với màu nước biển trong vắt, bãi cát trắng trải dài cùng hàng dừa đung đưa trong gió khiến bất cứ du khách đến đây đều ngạc nhiên với khung cảnh tuyệt đẹp tựa như chốn thiên đường. Hòn Gầm Ghì hay còn gọi là hòn Dăm Ngang, nằm phía Nam thị trấn An Thới (TP Phú Quốc, Kiên Giang), là một phần của quần đảo gồm 17 đảo nhỏ. Hiện tại để ra được hòn Gầm Ghì chỉ có một cách duy nhất là thuê tàu đi từ cảng An Thới. Trên đường đi, du khách có thể chiêm ngưỡng vẻ đẹp của biển cả bao la, bầu trời xanh trong vắt và cảm nhận những cơn sóng đang vỗ nhẹ mơn man ôm lấy mạn tàu. Điểm nổi bật ở hòn Gầm Ghì là các rạn hô tại đây trải dài trên vùng biển rộng lớn, lấp lánh rực rỡ dưới làn nước xanh trong màu ngọc bích. Đây cũng chính là nơi bảo tồn san hô của vùng phía Nam đảo ngọc Phú Quốc. Tại hòn Gầm Ghì có rất nhiều đảo đá với nhiều hình thù lạ mắt, nằm sừng sững giữa biển khơi, khi sóng đánh tung bọt trắng xóa tạo nên khung cảnh ấn tượng và kỳ vĩ. Đến nơi đây, du khách có thể rũ bỏ hết những bộn bề cuộc sống thường ngày để thưởng thức trọn vẹn phút giây hòa mình vào thiên nhiên thơ mộng. Bên cạnh đó, nguồn hải sản tại đây rất phong phú và tươi ngon, nên du khách còn có thể tự chuẩn bị tiệc BBQ hải sản do chính mình đánh bắt.</vn:description>
    <vn:address>Còn gọi là Hòn Dăm Ngang, nằm ở nơi xa nhất về phía nam của quần đảo An Thới, Thành phố Phú Quốc, An Giang</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=696</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_37a1bb1b5038ef4f</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_84c51f66e615508d"/>
  </rdf:Description>
