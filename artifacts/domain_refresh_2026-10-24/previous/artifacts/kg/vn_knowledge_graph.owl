  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_d21c0266ce5119c2">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Khu du lịch Nhà Mát</rdfs:label>
    <vn:name>Khu du lịch Nhà Mát</vn:name>
    <vn:description xml:lang="vi">Khu du lịch Nhà Mát là điểm du lịch nổi tiếng nhất của Bạc Liêu. Với bãi biển nhân tạo lớn, nhiều trò chơi thú vị như tàu lượn trên không, đi xe điện đụng,.. hay rạp phim 6D, phòng massgae,.. đây hứa hẹn sẽ là điểm đến xua tan nắng nóng ngột ngạt cho du khách mùa hè này. Biển tắm Nhân tạo (Biển Tiên Rồng) là một trong những điểm tiêu biểu và thu hút du khách đặc sắc nhất của khu du lịch Nhà Mát. Biển Tiên Rồng gồm khu công viên nước dành cho trẻ em và người lớn, với diện tích rộng, quy mô lớn và đẹp nhất khu vực Đồng bằng Sông Cửu Long cùng công nghệ tạo sóng của Tây Ban Nha hiện đại. Ngự trị hòa cùng sóng nước là hình tượng của Cá chép hóa rồng, Sư tử biển, các nhân vật trong thế giới thủy cung như vua thủy tề, nàng tiên cá rất sinh động. Tại đây du khách sẽ được hòa mình trong làn nước biển trong xanh tuyệt đẹp. Tận hưởng không khí sôi động và đầy màu sắc tại ngay bãi biển với tổ hợp ghế nằm, thức uống giải khác, thưởng thức ẩm thực tinh tế sau những giờ vui chơi thỏa thích.</vn:description>
    <vn:address>, Bạc Liêu</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=1087</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_d21c0266ce5119c2</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_0d78fe83be3cd4aa"/>
  </rdf:Description>
