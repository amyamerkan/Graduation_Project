  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/ward_eb625d508ca574dd">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#Ward"/>
    <rdfs:label xml:lang="vi">Phường An Sinh</rdfs:label>
    <vn:name>Phường An Sinh</vn:name>
    <vn:code>07090</vn:code>
    <vn:description xml:lang="vi">Theo danh mục được thu thập ngày 2026-10-24, Phường An Sinh có mã 07090, cấp ward, thuộc Thành phố Quảng Ninh. Mốc snapshot: 2026-10-24.</vn:description>
