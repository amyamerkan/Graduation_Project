    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_c84c7da288614088"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/ward_0c4e5b0a54f83deb">
