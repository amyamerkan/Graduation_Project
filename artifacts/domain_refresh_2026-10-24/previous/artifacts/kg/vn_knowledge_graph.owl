  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_8931ab3ff807ac36">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Khu Sinh thái Nhà Xưa</rdfs:label>
    <vn:name>Khu Sinh thái Nhà Xưa</vn:name>
    <vn:description xml:lang="vi">Khu sinh thái nhà xưa xứng đáng là địa điểm du lịch Vĩnh Long mang cảm giác hoài cổ rõ nhất cho người tham quan. Gọi là khu sinh thái là vì ngoài căn nhà cổ đã nhuốm màu thời gian, bao xung quanh là những cây cảnh, vườn cây ăn trái tạo cảm giác xanh mát hài hòa. Ngay cả những người không rõ về kiến trúc cũng phải trầm trồ khi ngắm nhìn những họa tiết điêu khắc chim muông, hoa lá,… Ngôi nhà cổ toàn bộ được xây dựng bằng gỗ quý, có lịch sử lâu đời hơn cả tổng số tuổi của một nhóm khách du lịch cộng lại.</vn:description>
    <vn:address>rạch Ông Me thuộc ấp Phước Ngươn A, Huyện Long Hồ, Vĩnh Long</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=1074</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_8931ab3ff807ac36</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_c5f44df60fc7e6f5"/>
  </rdf:Description>
