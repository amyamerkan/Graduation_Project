  <rdf:Description rdf:about="https://w3id.org/vn-assistant/resource/tourismplace_9c33ad4395c38203">
    <rdf:type rdf:resource="https://w3id.org/vn-assistant/ontology#TourismPlace"/>
    <rdfs:label xml:lang="vi">Thác Sơ Roách và thác Hơ Kook</rdfs:label>
    <vn:name>Thác Sơ Roách và thác Hơ Kook</vn:name>
    <vn:description xml:lang="vi">Thác Sơ Roách và thác Hơ Kook cao 17-50m với vẻ đẹp hoang sơ nằm ở xã Kon Plông (tỉnh Quảng Ngãi) vừa mới được phát hiện. Theo đó, thác đầu tiên được người dân đặt tên là Sơ Roách, nằm tại thôn Kon Plông, xã Kon Plông, cách trung tâm xã 7 - 8km, thuộc quản lý của Công ty TNHH MTV Lâm nghiệp Kon PLôn Thác Sơ Roách cao khoảng 15 - 17 m, chảy xuống lòng hồ chu vi trên 100m2. Thác thứ hai được đặt tên là Hơ Kook, nằm trong khu vực quản lý của Ban Quản lý rừng phòng hộ Thạch Nham, cách trung tâm xã 15 - 17km. Thác nằm giữa rừng cây nguyên sinh cao khoảng 50m. Đáng chú ý, từ thác chính đi ngược dòng suối khoảng 500 - 700m, đoàn khảo sát gặp thác phụ cao khoảng 20m. Địa phương đang xây dựng kế hoạch cụ thể để quy hoạch, bảo tồn và khai thác hiệu quả các địa điểm này trong thời gian tới, đảm bảo phát triển du lịch gắn với bảo vệ môi trường tự nhiên. Việc phát hiện thêm hai thác được kì vọng sẽ góp phần thúc đẩy du lịch, tạo sinh kế bền vững cho người dân tại địa phương.</vn:description>
    <vn:address>Kon Plông, Kon Plông, Quảng Ngãi</vn:address>
    <vn:sourceUrl>https://csdl.vietnamtourism.gov.vn/dest/?item=1276</vn:sourceUrl>
    <vn:sourceName>Cơ sở dữ liệu ngành Du lịch — TITC</vn:sourceName>
    <vn:sourceRecordId>tourism_place_9c33ad4395c38203</vn:sourceRecordId>
    <vn:locatedIn rdf:resource="https://w3id.org/vn-assistant/resource/province_8999671be65a3fdb"/>
  </rdf:Description>
