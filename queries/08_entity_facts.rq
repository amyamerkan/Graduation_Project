PREFIX vn: <https://w3id.org/vn-assistant/ontology#>
SELECT DISTINCT ?entity ?type ?name ?code ?description ?provinceName ?validFrom ?validTo WHERE {
  ?entity a ?type ; vn:name ?name .
  FILTER(STRSTARTS(STR(?type), "https://w3id.org/vn-assistant/ontology#"))
  FILTER(CONTAINS(LCASE(STR(?name)), LCASE("{{keyword}}")))
  OPTIONAL { ?entity vn:code ?code }
  OPTIONAL { ?entity vn:description ?description }
  OPTIONAL { ?entity vn:validFrom ?validFrom }
  OPTIONAL { ?entity vn:validTo ?validTo }
  OPTIONAL { ?entity vn:locatedIn ?province . ?province a vn:Province ; vn:name ?provinceName }
}
ORDER BY ?name
LIMIT {{limit}}
